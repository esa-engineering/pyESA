<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allowance override"
        Height="420" Width="560"
        MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="📐 Allowance override"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- SECTION: Items -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="📋 ITEMS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="txt_items_count" Style="{StaticResource SectionHeader}" Margin="5,0,0,5"/>
                </StackPanel>
                <TextBox x:Name="txt_items" Grid.Row="1" IsReadOnly="True" Background="#F8F8F8"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" Padding="5,3" FontSize="11"/>
            </Grid>
        </Border>

        <!-- SECTION: Value -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
            <StackPanel>
                <TextBlock Text="➕ ALLOWANCE FOR FITTINGS AND WASTE" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="Replaces the allowance of the category (Rules tab) on the linear elements of these items, in every WBS combination. Piece categories are always counted 1 per instance. 0 means no allowance."/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Allowance:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txt_allowance" Style="{StaticResource InputField}"
                             ToolTip="Percentage, decimal comma or point (e.g. 15 or 12,5)"/>
                    <TextBlock Text="%" Style="{StaticResource UnitLabel}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button x:Name="btn_remove" Content="Remove Override" Padding="10,3" Height="30"
                    HorizontalAlignment="Left"
                    ToolTip="Go back to the allowance of the category"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_cancel" Content="Cancel" Width="100" Height="30"
                        Margin="0,0,10,0"/>
                <Button x:Name="btn_ok" Content="OK" Width="100" Height="30"
                        IsDefault="True"
                        Background="#2D5A8A" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
