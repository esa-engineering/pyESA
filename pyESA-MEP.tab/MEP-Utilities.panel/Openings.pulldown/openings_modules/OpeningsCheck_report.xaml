<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openings Interactive Report" Width="940" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="🗂 OPENINGS INTERACTIVE REPORT" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10"
                    Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="🗂 OPENINGS BY STATUS"/>
                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" VerticalAlignment="Center"/>
                    </Grid>
                    <TreeView Grid.Row="2" x:Name="OpeningsTree"/>
                    <StackPanel x:Name="TickButtons" Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="SelectAllButton" Content="Select All" Width="90" Height="26" Margin="0,0,5,0"/>
                        <Button x:Name="DeselectAllButton" Content="Deselect All" Width="90" Height="26"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Text="Shift + click on a box: ticks (or unticks) every opening from the last box clicked"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="🔎 DETAIL"/>
                            <TextBlock x:Name="DetailText" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="👆 SELECTED ITEM"/>
                            <Button x:Name="ShowButton" Content="Show in model" Height="28" Margin="0,0,0,5"/>
                            <Button x:Name="SelectCloseButton" Content="Select and close" Height="28" Margin="0,0,0,5"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="An opening selects it with its elements; a status group selects all its openings and elements."/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ActionsBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="🛠 TICKED OPENINGS"/>
                            <Button x:Name="RecreateButton" Content="Recreate" Height="28" Margin="0,0,0,5"/>
                            <Button x:Name="MoveButton" Content="Move onto their elements" Height="28" Margin="0,0,0,5"/>
                            <Button x:Name="DeleteButton" Content="Delete (Not Associated)" Height="28" Margin="0,0,0,5"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Recreate: the ticked openings are recreated on their elements. A preview says, opening by opening, what happens (recreated, split in two, joined with nearby openings, elements losing the association), then new openings with new Ids, status Valid, and the Ids on the MEP elements updated. Move: same size, centred on elements that moved out. Delete: only Not Associated openings; their Ids are removed from the MEP elements. Each action checks again only the ticked openings and the ones next to them, before and after; the others stay as they are. Refresh checks the whole scope."/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1" CornerRadius="5"
                            Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Foreground="Gray" Text="ℹ LAST ACTION"/>
                            <TextBlock Style="{StaticResource HintText}" x:Name="StatusText" Text="None yet. Revit stays usable while this window is open: use Refresh after changing the model."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="⟳ Refresh" Width="100" Height="30" Margin="0,0,10,0"
                    ToolTip="New Report on the scope: the model may have changed while this window was open"/>
            <Button x:Name="TextButton" Content="Text report" Width="100" Height="30" Margin="0,0,10,0"/>
            <Button x:Name="CloseButton" Content="Close" Width="100" Height="30" IsCancel="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
