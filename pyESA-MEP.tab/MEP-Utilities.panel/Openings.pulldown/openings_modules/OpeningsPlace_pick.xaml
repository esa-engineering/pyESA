<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openings Place&amp;Check" Width="560" Height="700" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="🕳 OPENINGS PLACE&amp;CHECK" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🎯 WHAT TO SELECT"/>
                        <RadioButton x:Name="HostsRadio" GroupName="Pick" Margin="0,5"
                                     Content="Walls, floors and structural elements"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,5"
                                   Text="In this model or in RVT links. Every pipe, duct, cable tray and conduit crossing them, of this model or of the ticked links, gets an opening."/>
                        <RadioButton x:Name="MepsRadio" GroupName="Pick" Margin="0,5"
                                     Content="MEP elements (pipes, ducts, cable trays, conduits)"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,5"
                                   Text="Of this model if it has its own, otherwise of the linked models. Their crossings with the walls, floors and structural elements of this model and of the ticked links get an opening."/>
                        <RadioButton x:Name="AreaRadio" GroupName="Pick" Margin="0,5" Content="Area"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,5"
                                   Text="In a plan view drag a rectangle (height: view range of the plan); in a 3D view the section box is used. Every crossing inside it, between MEP elements and walls, floors and structural elements of this model or of the ticked links, gets an opening."/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🔗 LINKED MODELS"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                   Text="Ticked links are read, for MEP elements and for walls, floors and structural elements. This model is always read. Remembered for this model; new links come up ticked."/>
                        <TextBlock x:Name="NoLinksText" Style="{StaticResource HintText}" Visibility="Collapsed"
                                   Text="No loaded RVT links: only this model is read."/>
                        <ListBox x:Name="LinksList" MaxHeight="160" Margin="0,0,0,6"/>
                        <StackPanel x:Name="LinksButtons" Orientation="Horizontal">
                            <Button x:Name="SelectAllButton" Content="Select All" Width="90" Height="24" Margin="0,0,8,0"/>
                            <Button x:Name="DeselectAllButton" Content="Deselect All" Width="90" Height="24"/>
                        </StackPanel>
                        <TextBlock x:Name="PhaseText" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1" CornerRadius="5" Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Foreground="Gray" Text="ℹ SETTINGS"/>
                        <TextBlock Style="{StaticResource HintText}" x:Name="SettingsInfo"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="With elements already selected this window is skipped: MEP elements and openings already associated are refreshed, the other MEP elements and the walls, floors and structural elements get openings, reading the links ticked last time."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Select" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
