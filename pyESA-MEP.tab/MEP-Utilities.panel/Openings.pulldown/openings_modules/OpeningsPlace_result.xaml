<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openings Place&amp;Check" Width="640" Height="620" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Run Text="🕳 "/><Run x:Name="HeaderText" Text="OPENINGS PLACE&amp;CHECK"/>
        </TextBlock>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📋 RESULT"/>
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel x:Name="SummaryPanel"/>
                    </StackPanel>
                </Border>
                <Border x:Name="WarningBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="⚠ TO CHECK"/>
                        <TextBlock x:Name="WarningText" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="OpeningsBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🧱 NEW OPENINGS"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                   Text="Opening | kind and shape | size [mm] | discipline | crossed element | MEP elements"/>
                        <ListBox x:Name="OpeningsList" MaxHeight="260"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1" CornerRadius="5" Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Foreground="Gray" Text="ℹ DETAILS"/>
                        <TextBlock Style="{StaticResource HintText}" x:Name="DetailsText"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SelectButton" Content="Select new openings" Width="150" Height="30" Margin="0,0,10,0"/>
            <Button x:Name="CloseButton" Content="Close" Width="100" Height="30" IsDefault="True" IsCancel="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
