<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openings Report" Width="540" Height="640" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- scheda grande: pulsante con titolo e descrizione -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="MinHeight" Value="96"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="🔍 OPENINGS REPORT" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}"><Run Text="📊 "/><Run x:Name="SummaryTitle" Text="REPORT"/></TextBlock>
                        <StackPanel x:Name="TotalsPanel"/>
                    </StackPanel>
                </Border>
                <Border x:Name="WarningBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}"><Run Text="⚠ "/><Run x:Name="WarningTitle" Text="NOT WRITTEN"/></TextBlock>
                        <TextBlock Style="{StaticResource HintText}" x:Name="WarningText"/>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="TextButton" Style="{StaticResource CardButton}">
                        <StackPanel>
                            <TextBlock Text="📄 Text Report" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Read-only list by status: every opening with its elements and what happened to them. Export to Excel."/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="OkButton" Style="{StaticResource CardButton}" IsDefault="True"
                            BorderBrush="#2D5A8A" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="🗂 Interactive Report" FontSize="13" FontWeight="Bold" Foreground="#2D5A8A"
                                       Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource HintText}" x:Name="WindowHint"
                                       Text="Select openings and elements in the model; create, recreate, move or delete openings. Revit stays usable."/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- terzo pulsante: Export nel modello Openings, Import nei modelli MEP / ARC (uno dei due pannelli) -->
                <Button x:Name="ThirdButton" Style="{StaticResource CardButton}" MinHeight="70" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel x:Name="ExportPanel">
                            <TextBlock Text="📤 Export report" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource HintText}" x:Name="ExportHint"/>
                        </StackPanel>
                        <StackPanel x:Name="ImportPanel" Visibility="Collapsed">
                            <TextBlock Text="📥 Import report" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource HintText}" x:Name="ImportHint"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <TextBlock x:Name="ThirdStatus" Style="{StaticResource HintText}" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="Close" Width="80" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
