<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Workset Fix"
        Height="840" Width="520"
        MinHeight="560" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🗂️ MEP Workset Fix"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Main content with scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel Margin="0,0,10,0">

                <!-- SECTION: Mechanical -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🌀 MECHANICAL SYSTEMS" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Workset:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_mechanical" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                      ToolTip="Workset that receives the mechanical (HVAC) elements"/>
                        </Grid>
                        <TextBlock x:Name="txt_hint_mechanical" Style="{StaticResource HintText}" Text=""/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Plumbing -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💧 PLUMBING SYSTEMS" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Workset:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_plumbing" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                      ToolTip="Workset that receives the plumbing elements"/>
                        </Grid>
                        <TextBlock x:Name="txt_hint_plumbing" Style="{StaticResource HintText}" Text=""/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Fire protection -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔥 FIRE PROTECTION SYSTEMS" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Workset:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_fire" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                      ToolTip="Workset that receives the fire protection elements"/>
                        </Grid>
                        <TextBlock x:Name="txt_hint_fire" Style="{StaticResource HintText}" Text=""/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Electrical -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚡ ELECTRICAL SYSTEMS" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Workset:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_electrical" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                      ToolTip="Workset that receives the electrical elements"/>
                        </Grid>
                        <TextBlock x:Name="txt_hint_electrical" Style="{StaticResource HintText}" Text=""/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Excluded worksets -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🚧 WORKSETS TO LEAVE UNTOUCHED" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Elements in these worksets (for example temporary elements) are never moved, whatever their System Type. They cannot also be a target."/>
                        <!-- Righe tendina + rimozione, create da codice -->
                        <StackPanel x:Name="pnl_excluded"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button x:Name="btn_add_excluded" Content="+ Add workset" Padding="10,3"
                                    ToolTip="Add another workset to leave untouched"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION: Scope -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎯 ELEMENTS TO PROCESS" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Margin="20,5,0,0">
                            <RadioButton x:Name="rdo_scope_model" GroupName="scope"
                                         Content="All elements in the model"/>
                            <RadioButton x:Name="rdo_scope_view" GroupName="scope" Margin="0,4,0,0"
                                         Content="Only elements visible in the active view"/>
                            <RadioButton x:Name="rdo_scope_selection" GroupName="scope" Margin="0,4,0,0"
                                         Content="Only the current selection"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- INFO -->
                <Border BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ℹ️ HOW IT WORKS"
                                   Style="{StaticResource SectionHeader}" Foreground="Gray"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
                            <Run Text="The section of each element is chosen from the name of its System Type (case does not matter)."/>
                            <LineBreak/>
                            <Run Text="Elements whose System Type matches no rule, or rules of two different sections, are left where they are and listed in the report."/>
                            <LineBreak/>
                            <Run Text="A section set to (do not change) leaves its elements untouched."/>
                            <LineBreak/>
                            <Run Text="Insulation and lining follow the element they belong to. A summary is shown before anything is written."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btn_cancel" Content="Cancel" Width="100" Height="30"
                    Margin="0,0,10,0"/>
            <Button x:Name="btn_ok" Content="OK" Width="100" Height="30"
                    IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
