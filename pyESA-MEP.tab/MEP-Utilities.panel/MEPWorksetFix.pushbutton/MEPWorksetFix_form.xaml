<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Workset Fix"
        Height="850" Width="1060"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <!-- Etichetta di riga della tabella dei workset: come SectionHeader, senza margini -->
        <Style x:Key="RowHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <!-- Descrizione a destra della tendina -->
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="15,4,0,0"/>
        </Style>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🗂️ MEP Workset Fix"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Main content with scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel Margin="0,0,10,0">

                <!-- INFO -->
                <Border BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ℹ️ HOW IT WORKS"
                                   Style="{StaticResource SectionHeader}" Foreground="Gray"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
                            <Run Text="The section of each element is chosen from the name of its System Type (case does not matter)."/>
                            <LineBreak/>
                            <Run Text="Elements whose System Type matches no rule, or rules of two different sections, are left where they are and listed in the report."/>
                            <LineBreak/>
                            <Run Text="A section set to (do not change) leaves its elements untouched. Elements inside model groups are never moved."/>
                            <LineBreak/>
                            <Run Text="Insulation and lining follow the element they belong to. A summary is shown before anything is written."/>
                            <LineBreak/>
                            <Run FontWeight="Bold" Text="Not handled by this tool: Communication Devices, Generic Models, Lighting Fixtures, Mechanical Equipment, Pipe Accessories, Plumbing Fixtures and Specialty Equipment. Assign their workset with a Multi-Category Schedule."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- SECTION: Scope -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎯 ELEMENTS TO PROCESS" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Margin="20,5,0,0">
                            <RadioButton x:Name="rdo_scope_model" GroupName="scope"
                                         Content="All elements in the model"/>
                            <RadioButton x:Name="rdo_scope_view" GroupName="scope" Margin="0,4,0,0"
                                         Content="Only elements visible in the active view"/>
                            <RadioButton x:Name="rdo_scope_selection" GroupName="scope" Margin="0,4,0,0"
                                         Content="Only the current selection"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION: Target worksets, una riga per sezione.
                     Colonne: 190 etichetta / 280 tendina / * descrizione.
                     Le righe dei workset da non toccare (MEPWorksetFix_ui.py,
                     LABEL_COLUMN_WIDTH / COMBO_COLUMN_WIDTH) usano le stesse misure. -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📥 TARGET WORKSETS" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Section" Style="{StaticResource ColumnTitle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Workset" Style="{StaticResource ColumnTitle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="What goes there" Margin="15,0,0,0"
                                       Style="{StaticResource ColumnTitle}"/>

                            <!-- Mechanical -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="🌀 MECHANICAL SYSTEMS"
                                       Style="{StaticResource RowHeader}"/>
                            <ComboBox x:Name="cbo_mechanical" Grid.Row="1" Grid.Column="1"
                                      Style="{StaticResource ComboStyle}" Margin="0,4"
                                      VerticalAlignment="Top"
                                      ToolTip="Workset that receives the mechanical (HVAC) elements"/>
                            <TextBlock x:Name="txt_hint_mechanical" Grid.Row="1" Grid.Column="2"
                                       Style="{StaticResource RowHint}" Text=""/>

                            <!-- Plumbing -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="💧 PLUMBING SYSTEMS"
                                       Style="{StaticResource RowHeader}"/>
                            <ComboBox x:Name="cbo_plumbing" Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource ComboStyle}" Margin="0,4"
                                      VerticalAlignment="Top"
                                      ToolTip="Workset that receives the plumbing elements"/>
                            <TextBlock x:Name="txt_hint_plumbing" Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource RowHint}" Text=""/>

                            <!-- Fire protection -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="🔥 FIRE PROTECTION SYSTEMS"
                                       Style="{StaticResource RowHeader}"/>
                            <ComboBox x:Name="cbo_fire" Grid.Row="3" Grid.Column="1"
                                      Style="{StaticResource ComboStyle}" Margin="0,4"
                                      VerticalAlignment="Top"
                                      ToolTip="Workset that receives the fire protection elements"/>
                            <TextBlock x:Name="txt_hint_fire" Grid.Row="3" Grid.Column="2"
                                       Style="{StaticResource RowHint}" Text=""/>

                            <!-- Electrical -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="⚡ ELECTRICAL SYSTEMS"
                                       Style="{StaticResource RowHeader}"/>
                            <ComboBox x:Name="cbo_electrical" Grid.Row="4" Grid.Column="1"
                                      Style="{StaticResource ComboStyle}" Margin="0,4"
                                      VerticalAlignment="Top"
                                      ToolTip="Workset that receives the electrical elements"/>
                            <TextBlock x:Name="txt_hint_electrical" Grid.Row="4" Grid.Column="2"
                                       Style="{StaticResource RowHint}" Text=""/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION: Excluded worksets -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🚧 WORKSETS TO LEAVE UNTOUCHED" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Elements in these worksets (for example temporary elements) are never moved, whatever their System Type. They cannot also be a target."/>
                        <!-- Righe tendina + rimozione, create da codice -->
                        <StackPanel x:Name="pnl_excluded"/>
                        <Button x:Name="btn_add_excluded" Content="+ Add workset" Padding="10,3"
                                Margin="190,5,0,0" HorizontalAlignment="Left"
                                ToolTip="Add another workset to leave untouched"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btn_cancel" Content="Cancel" Width="100" Height="30"
                    Margin="0,0,10,0"/>
            <Button x:Name="btn_ok" Content="OK" Width="100" Height="30"
                    IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
