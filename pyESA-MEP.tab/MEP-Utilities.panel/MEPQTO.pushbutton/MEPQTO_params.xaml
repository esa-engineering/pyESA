<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model parameters"
        Height="820" Width="620"
        MinHeight="480" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🔧 Model parameters"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel Margin="0,0,10,0">

                <!-- SECTION: Piece categories -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🏷️ PRICE CODES - TYPE (PIECE CATEGORIES)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Type parameters holding the price codes of air terminals, devices, fixtures, equipment, accessories, conduit fittings and sprinklers. When the type has no such parameter, the instance parameter with the same name is read."/>
                        <Grid x:Name="grd_piece" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION: Instance codes, all categories -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📏 PRICE CODES - INSTANCE (ALL CATEGORIES)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Instance parameters holding price codes, read on every element of every category. For ducts, flex ducts, pipes, flex pipes, cable trays, conduits and insulation they are the only codes (the code changes with the size). For the piece categories they are counted in addition to the type codes above; a code on both the type and the instance counts once."/>
                        <Grid x:Name="grd_linear" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION: Include -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="✅ INCLUDE IN THE BILL (YES/NO)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Instance parameter, read on every element of every category. Elements whose parameter is set to No are left out of the bill and listed in the Issues tab. Elements without the parameter, or without a value, are counted."/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="All categories (instance):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_include" Grid.Column="1" IsEditable="True"
                                      Style="{StaticResource ComboStyle}"
                                      ToolTip="Yes/No instance parameter of all categories (empty = not used)"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Button x:Name="btn_defaults" Content="Restore Defaults" Padding="10,3" Height="30"
                    HorizontalAlignment="Left"
                    ToolTip="e_DAT_PriceCode_1..10, e_DAT_PriceCode_i_1..10, e_DAT_BOQ_i"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_cancel" Content="Cancel" Width="100" Height="30"
                        Margin="0,0,10,0"/>
                <Button x:Name="btn_ok" Content="OK" Width="100" Height="30"
                        IsDefault="True"
                        Background="#2D5A8A" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
