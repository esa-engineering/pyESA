<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Report"
        Height="760" Width="760"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="💥 Clash Report"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SECTION: Result -->
            <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📊 RESULT" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="txt_result" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txt_result_hint" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- SECTION: Clashes -->
            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="💥 CLASHES" Style="{StaticResource SectionHeader}"/>
                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txt_search" Grid.Column="1" Padding="5,3"
                                 ToolTip="Show only the clashes whose elements contain this text (category, family, type, level or id)"/>
                        <Button x:Name="btn_clear_search" Grid.Column="2" Content="✕" Width="25" Margin="5,0,15,0" ToolTip="Clear search"/>
                        <TextBlock Grid.Column="3" Text="Group by:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cbo_group" Grid.Column="4" Style="{StaticResource ComboStyle}"/>
                    </Grid>
                    <TreeView x:Name="tree" Grid.Row="2" MinHeight="200"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="btn_expand" Content="Expand All" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_collapse" Content="Collapse All" Padding="10,3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION: Navigation -->
            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="🧭 NAVIGATION" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Click a row to select its elements in Revit: a clash selects its two elements, a group or a test selects all the elements under it."/>
                    <StackPanel Margin="20,5,0,0">
                        <CheckBox x:Name="chk_zoom" Content="Zoom to the selected elements"/>
                        <CheckBox x:Name="chk_section_box" Margin="0,4,0,0"
                                  Content="Fit the section box of the active 3D view around them"/>
                    </StackPanel>
                    <Grid Margin="20,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Section box margin:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_margin" Grid.Column="1" Style="{StaticResource InputField}" Text="50"/>
                        <TextBlock Grid.Column="2" Text="cm" Style="{StaticResource UnitLabel}"/>
                    </Grid>
                    <StackPanel Margin="20,8,0,0">
                        <CheckBox x:Name="chk_transparent"
                                  Content="Make the other categories transparent in the active view"/>
                    </StackPanel>
                    <Grid Margin="40,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transparency:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_transparency" Grid.Column="1" Style="{StaticResource InputField}" Text="80"/>
                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource UnitLabel}"/>
                        <Button x:Name="btn_restore_view" Grid.Column="3" Content="Restore view graphics" Padding="10,3"
                                HorizontalAlignment="Left"
                                ToolTip="Put back the category overrides that Clash Finder changed"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="40,5,0,0"
                               Text="Category overrides of the active view: the categories of the selected row keep their look. The original overrides come back with the button, when the option is turned off, or when this window closes."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btn_export" Content="Export CSV..." Width="100" Height="30"
                    Margin="0,0,10,0"/>
            <Button x:Name="btn_close" Content="Close" Width="100" Height="30"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
