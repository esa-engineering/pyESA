<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element To Insulation"
        Width="460" Height="520"
        MinWidth="400" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🧣 ELEMENT TO INSULATION" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🔤 PARAMETERS"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Copy:"/>
                            <TextBox Grid.Column="1" x:Name="ParamsBox" VerticalContentAlignment="Center"
                                     ToolTip="Parameter names, separated by ;"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Parameter names separated by ; (e.g. Comments;Mark). Each one must exist on both the host and the insulation. Text, number, Yes/No and element parameters are supported; empty text values are not copied."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🎯 SCOPE"/>
                        <RadioButton x:Name="ModeSelected" GroupName="Scope" Margin="0,3"
                                     Content="Only the insulation of the selected elements"/>
                        <RadioButton x:Name="ModeAll" GroupName="Scope" Margin="0,3"
                                     Content="All insulation in the project"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📁 CATEGORIES"/>
                        <CheckBox x:Name="CatPipe" Margin="0,3" Content="Pipe insulation"/>
                        <CheckBox x:Name="CatDuct" Margin="0,3" Content="Duct insulation"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Each insulation element gets the values of its host pipe or duct. The report lists how many insulation elements were found and updated."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
