<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rainwater Sections"
        Height="740" Width="1620"
        MinHeight="450" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <!-- Data grid (come MEPQTO_form.xaml) -->
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8E8E8"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <!-- Colonne del diametro nuovo: sfondo azzurro per distinguerle -->
        <Style x:Key="NewCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#EEF4FB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="📊 Rainwater Sections"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- SECTION: Settings and filter -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="⚙️ CHECK" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="txt_settings" Style="{StaticResource HintText}" Text=""/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="One row per section part: the horizontal pipes (45° runs included) and the vertical pipes of a section (System + Section parameter) are separate rows. Choose the new size from the sizes of the pipe type and tick Apply: all the pipes of that row get the size, with their fittings. Qmax, v, fill and check of the new size update with the choice."/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="v and fill are those at the design flow of the horizontal pipes (lowest velocity and highest fill of the row), derived from the tables with the partial-fill relation of a circular pipe. Vertical pipes have no velocity check. A fitting between the two parts of a section has one size: tick both parts with the same size, or keep a transition."/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txt_search" Grid.Column="1" Padding="5,3"
                             ToolTip="Filter by system, section, status or notes"/>
                    <Button x:Name="btn_clear_search" Grid.Column="2"
                            Content="✕" Width="25" Margin="5,0,0,0"
                            ToolTip="Clear search"/>
                    <CheckBox x:Name="chk_only_action" Grid.Column="3" Margin="15,0,0,0"
                              VerticalAlignment="Center"
                              Content="Only sections that need attention"
                              ToolTip="Hide the sections that are OK or carry no flow"/>
                    <TextBlock x:Name="txt_count" Grid.Column="4" Style="{StaticResource HintText}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0" Text=""/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <DataGrid x:Name="dg_sections" Grid.Row="2" Style="{StaticResource GridStyle}">
            <!-- Intestazioni su piu' righe: le colonne numeriche sono strette -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="VerticalContentAlignment" Value="Bottom"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="error">
                            <Setter Property="Background" Value="#FFC7CE"/>
                            <Setter Property="Foreground" Value="#9C0006"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="warning">
                            <Setter Property="Background" Value="#FFEB9C"/>
                            <Setter Property="Foreground" Value="#7A5B00"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="info">
                            <Setter Property="Foreground" Value="#2D5A8A"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="none">
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Apply" Width="45" SortMemberPath="Apply">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Apply, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Show" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🔍" Padding="2,0" Margin="1" Height="22" VerticalAlignment="Top"
                                    ToolTip="Select the pipes of this row in the model and navigate the active view; Finish or Esc returns to this table"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="System" Binding="{Binding System}" Width="95" IsReadOnly="True"/>
                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="55" IsReadOnly="True"
                                    SortMemberPath="SectionSort" ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Pipes" Binding="{Binding Pipes}" Width="42" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Run" Binding="{Binding Run}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Min slope [cm/m]" Binding="{Binding Slope, StringFormat=0.00}" Width="55" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Q [l/s]" Binding="{Binding Flow, StringFormat=0.00}" Width="50" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Model DN [mm]" Binding="{Binding ModelDn}" Width="55" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Model De [mm]" Binding="{Binding ModelDe}" Width="55" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Qmax model [l/s]" Binding="{Binding Capacity, StringFormat=0.0}" Width="55" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Use [%]" Binding="{Binding Use, StringFormat=0}" Width="45" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="v model [m/s]" Binding="{Binding VModel, StringFormat=0.00}" Width="50" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Fill model [%]" Binding="{Binding FillModel, StringFormat=0}" Width="45" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Suggested De [mm]" Binding="{Binding Suggested}" Width="72" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTemplateColumn Header="New size" Width="135" SortMemberPath="NewDeSort"
                                        CellStyle="{StaticResource NewCell}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding NewSize, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding HasSizes}" Padding="4,1" Margin="1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Qmax new [l/s]" Binding="{Binding QNew, StringFormat=0.0}" Width="55" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}" CellStyle="{StaticResource NewCell}"/>
                <DataGridTextColumn Header="v new [m/s]" Binding="{Binding VNew, StringFormat=0.00}" Width="50" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}" CellStyle="{StaticResource NewCell}"/>
                <DataGridTextColumn Header="Fill new [%]" Binding="{Binding FillNew, StringFormat=0}" Width="45" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}" CellStyle="{StaticResource NewCell}"/>
                <DataGridTextColumn Header="Check new" Binding="{Binding CheckNew}" Width="140" IsReadOnly="True"
                                    CellStyle="{StaticResource NewCell}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" MinWidth="180" IsReadOnly="True"
                                    ElementStyle="{StaticResource WrapCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btn_tick_resize" Content="Tick Sections to Resize" Padding="10,3" Margin="0,0,5,0"
                        ToolTip="Tick the undersized, not tabulated and high velocity sections whose suggested De is a size of the pipe type, and set it as new size"/>
                <Button x:Name="btn_untick_all" Content="Untick All" Padding="10,3" Margin="0,0,5,0"/>
                <Button x:Name="btn_show" Content="Select in Model" Padding="10,3" Margin="15,0,0,0"
                        ToolTip="Select in Revit the pipes of the highlighted rows and navigate the active view; Finish or Esc returns to this table"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btn_cancel" Content="Close" Width="100" Height="30"
                        Margin="0,0,10,0" ToolTip="Close without changing the model"/>
                <!-- Non IsDefault: Invio nella griglia non deve modificare il modello -->
                <Button x:Name="btn_ok" Content="Apply Changes" Width="120" Height="30"
                        Background="#2D5A8A" Foreground="White"
                        ToolTip="Set the new size on all the pipes of the ticked sections"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
