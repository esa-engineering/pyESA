<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rainwater Flow Calculation"
        Height="900" Width="540"
        MinHeight="600" MinWidth="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🌧️ Rainwater Flow Calculation"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Main content with scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel Margin="0,0,10,0">

                <!-- SECTION: Piping systems -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💧 PIPING SYSTEMS" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Style="{StaticResource HintText}"
                                   Text="The flow of every pipe is its Fixture Units value, read as l/s: the rainwater fixtures write their flow there and Revit sums it along the network."/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="System type:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_system" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                      ToolTip="Piping system type of the rainwater drainage: only its pipes are checked"/>
                        </Grid>

                        <TextBlock x:Name="txt_system_info" Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text=""/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Pipe series -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🧪 PIPE SERIES" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Series:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_series" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                      ToolTip="Column of Table 6.2 used for the stacks"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="The series sets the stack capacities and the diameters that can be suggested, for stacks and horizontal pipes alike."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Horizontal pipes -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="➡️ HORIZONTAL PIPES" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fill degree f:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbo_fill" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                      ToolTip="Fill degree of the sloped pipes: selects Table 6.3, 6.4 or 6.5"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="The slope is read from the pipe geometry. A slope between two table rows uses the lower row. Slopes under 0.5 cm/m cannot be checked; slopes over 10 cm/m use the 10 cm/m row."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Velocity -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💨 VELOCITY" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Minimum v:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_vmin" Grid.Row="0" Grid.Column="1" Style="{StaticResource InputField}"
                                     ToolTip="Sloped pipes slower than this at the design flow are LOW VELOCITY. Empty: no check"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="m/s (empty = no check)" Style="{StaticResource UnitLabel}"/>
                            <TextBlock Grid.Row="1" Text="Maximum v:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_vmax" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputField}"
                                     ToolTip="Sloped pipes faster than this at the design flow are HIGH VELOCITY. Empty: no check"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="m/s (empty = no check)" Style="{StaticResource UnitLabel}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Velocity of the sloped pipes at the design flow (not the table velocity, which holds at the table fill degree), derived from the tables with the partial-fill relation of a circular pipe. Set the limits required by the project. Stacks are not checked."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Stacks -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⬇️ VERTICAL STACKS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Pipes steeper than 60° from the horizontal are checked as vertical stacks against Table 6.2, with fill degree f = 0.33. Runs at 45° are checked as horizontal pipes (10 cm/m row). Each section is listed as a horizontal part and a vertical part."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Scope -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎯 SCOPE" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Margin="20,5,0,0">
                            <RadioButton x:Name="rdo_scope_all" GroupName="scope"
                                         Content="All pipes of the system type in the model"/>
                            <RadioButton x:Name="rdo_scope_view" GroupName="scope" Margin="0,4,0,0"
                                         Content="Only pipes visible in the active view"/>
                            <RadioButton x:Name="rdo_scope_selection" GroupName="scope" Margin="0,4,0,0"
                                         Content="Only the selected pipes"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- INFO -->
                <Border BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ℹ️ OUTPUT"
                                   Style="{StaticResource SectionHeader}" Foreground="Gray"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
                            <Run Text="The results open in a second window, one row per section (System + Section parameter)."/>
                            <LineBreak/>
                            <Run Text="The model is changed only for the sections ticked there, after confirmation."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btn_cancel" Content="Cancel" Width="100" Height="30"
                    Margin="0,0,10,0"/>
            <Button x:Name="btn_ok" Content="OK" Width="100" Height="30"
                    IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
