<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi ID Select"
        Width="1050" Height="720"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔎 MULTI ID SELECT" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="🎯 SELECT BY ID"/>
                <TextBox x:Name="IdsBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PasteButton" Grid.Column="0" Content="Paste" Width="90"/>
                    <TextBlock Grid.Column="1" x:Name="IdsCountLabel" Style="{StaticResource UnitLabel}"/>
                    <Button x:Name="SelectButton" Grid.Column="2" Content="Select" Width="100" Height="30"
                            Background="#2D5A8A" Foreground="White"/>
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Margin="0,5,0,0"
                           Text="Any separator works (comma, space, new line). Each Id is searched in this model and in every loaded link; an Id found in more than one model selects all the matches. The result is listed in the table below."/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="Bold"
                           Foreground="#2D5A8A"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="📋 SELECTION"/>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="LoadButton" Content="Load selection" Width="110" Margin="0,0,8,0"
                                ToolTip="Read the elements selected in Revit now, linked elements included"/>
                        <Button x:Name="CopyButton" Content="Copy Ids" Width="90" Margin="0,0,8,0"
                                ToolTip="Copy the Ids of the listed elements, grouped by model"/>
                        <Button x:Name="CopyTableButton" Content="Copy table" Width="90"
                                ToolTip="Copy the whole table with headers, ready to paste in Excel"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="SelectionCountLabel" Style="{StaticResource UnitLabel}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" x:Name="SelectionGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8E8E8" AlternatingRowBackground="#F8F8F8"
                              SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                              Margin="0,0,10,0"/>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Parameters to show:" Margin="0,0,0,4"/>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" x:Name="ParamSearchBox" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Button DockPanel.Dock="Bottom" x:Name="ClearParamsButton" Content="Deselect All"
                                Width="90" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <ListBox x:Name="ParamList"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Close" Width="80" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
