<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fitting Rotate" Width="480" Height="580" MinWidth="460" MinHeight="570"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <!-- righe di stato: compaiono solo quando c'e' qualcosa da dire (set_status in BranchTools_Controls.py) -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🔄 FITTING ROTATE" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            <!-- icona info: il tooltip "How to use" resta aperto finche' il mouse e' sopra -->
            <Border Width="22" Height="22" BorderBrush="#444444" BorderThickness="1.5" CornerRadius="3"
                    Background="Transparent" Cursor="Help" HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="120000">
                <TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border.ToolTip>
                    <ToolTip MaxWidth="520">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="HOW TO USE" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="Select one fitting (or a pipe, for Align) first, or pick it after the click. Every change shows in the model at once. OK keeps all changes as one Undo step; Cancel or Esc puts everything back."/>
                                <LineBreak/>
                                <Run Text="Sliders: − and + move one step, the box takes an exact value (Enter applies it), Back to start returns to the first value."/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="ROTATE" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="Angle of the branch around the run: 0 = horizontal, 90 = straight up, -90 = down. 0 is on the side the branch faces when the window opens. Wyes and tees turn around the main, elbows around their connected end. A fitting connected off its axis does not turn."/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="BRANCH ANGLE" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="Sets the Angle parameter of the family (for example the branch of a wye). Values the family refuses are rolled back."/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="ALIGN" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Keeps the changes and closes the window, then pick the pipe or fitting to line up with. The selected element moves across until its open end is in line with the facing open end of the picked one; then the gap closes and the ends connect. Pipes of different sizes get a reducer. If connecting fails, the alignment stays."/>
                            </TextBlock>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
            </Border>
        </Grid>
        <StackPanel Grid.Row="1">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="🔄 ROTATE"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RotateMinusButton" Grid.Column="0" Content="−" Width="26" Height="24"/>
                        <Slider x:Name="RotateSlider" Grid.Column="1" Minimum="-180" Maximum="180" Value="0"
                                TickPlacement="BottomRight" IsSnapToTickEnabled="True" TickFrequency="5"
                                VerticalAlignment="Center" Margin="8,0"/>
                        <Button x:Name="RotatePlusButton" Grid.Column="2" Content="+" Width="26" Height="24"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Rotation" Width="70"/>
                        <TextBox x:Name="RotateBox" Style="{StaticResource InputField}" Text="0"
                                 ToolTip="0 = branch horizontal, 90 = straight up, -90 = down."/>
                        <TextBlock Style="{StaticResource UnitLabel}" Text="°"/>
                        <Button x:Name="RotateResetButton" Content="Back to start" Margin="10,0,0,0" Padding="8,2"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Step" Margin="14,0,6,0"/>
                        <ComboBox x:Name="RotateStepCombo" Width="60" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="RotateStatus" Style="{StaticResource HintText}"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="📐 BRANCH ANGLE"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AngleMinusButton" Grid.Column="0" Content="−" Width="26" Height="24"/>
                        <Slider x:Name="AngleSlider" Grid.Column="1" Minimum="0" Maximum="180" Value="45"
                                TickPlacement="BottomRight" IsSnapToTickEnabled="True" TickFrequency="2.5"
                                VerticalAlignment="Center" Margin="8,0"/>
                        <Button x:Name="AnglePlusButton" Grid.Column="2" Content="+" Width="26" Height="24"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Angle" Width="70"/>
                        <TextBox x:Name="AngleBox" Style="{StaticResource InputField}"
                                 ToolTip="Angle parameter of the family, 0 to 180."/>
                        <TextBlock Style="{StaticResource UnitLabel}" Text="°"/>
                        <Button x:Name="AngleResetButton" Content="Back to start" Margin="10,0,0,0" Padding="8,2"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Step" Margin="14,0,6,0"/>
                        <ComboBox x:Name="AngleStepCombo" Width="60" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="AngleStatus" Style="{StaticResource HintText}"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="↔ ALIGN"/>
                    <Button x:Name="AlignButton" Content="Align and connect" HorizontalAlignment="Left" Padding="12,4"
                            ToolTip="Then pick the pipe or fitting to line up with: the selected element moves and connects to it."/>
                    <TextBlock x:Name="AlignStatus" Style="{StaticResource HintText}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
