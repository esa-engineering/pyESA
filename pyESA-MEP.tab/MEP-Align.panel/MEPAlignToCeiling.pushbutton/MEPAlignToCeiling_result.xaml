<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Align to Ceiling - result"
        Width="1150" Height="650"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8E8E8"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="⬆️ MEP ALIGN TO CEILING" FontSize="16"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- SECTION: Summary -->
        <Border Grid.Row="1" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Foreground="Gray" Text="ℹ️ OUTCOME"/>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Text="-"/>
            </StackPanel>
        </Border>

        <!-- SECTION: Elements -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="📋 ELEMENTS NOT ALIGNED"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Padding="5,3"
                             ToolTip="Show only the rows that contain this text in any column"/>
                    <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" Width="25"
                            Margin="5,0,0,0" ToolTip="Clear search"/>
                    <Button x:Name="ClearFiltersButton" Grid.Column="3" Content="Clear Filters"
                            Padding="10,3" Margin="10,0,0,0"
                            ToolTip="Remove the search and every column filter"/>
                    <TextBlock x:Name="RowCount" Grid.Column="4" Style="{StaticResource UnitLabel}"
                               Margin="10,0,0,0" Text="-"/>
                </Grid>

                <TextBlock x:Name="EmptyText" Grid.Row="2" Panel.ZIndex="1" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="13"
                           Text="Every processed element was aligned: nothing to list."/>

                <DataGrid x:Name="ResultGrid" Grid.Row="2" Style="{StaticResource GridStyle}"
                          IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Not aligned">
                                    <Setter Property="Background" Value="#FFF4E5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Background" Value="#FDE2E2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Show" Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔍" Padding="2,0" Margin="1" Height="22" VerticalAlignment="Top"
                                            ToolTip="Select this element in the model and zoom to it; the window stays open while you edit it in Revit"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id, StringFormat=0}" Width="80"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Family: Type" Binding="{Binding Type}" Width="200"
                                            ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="90"/>
                        <DataGridTextColumn Header="Move (mm)" Binding="{Binding Move, StringFormat=+0;-0;0}"
                                            Width="80" ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn x:Name="BuzzerColumn" Header="dz_Buzzer (mm)"
                                            Binding="{Binding Buzzer, StringFormat=0}" Width="90"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"
                                            ElementStyle="{StaticResource WrapCell}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="The 🔍 button of a row selects the element in the model and zooms to it. This window stays open and Revit is free: navigate the view, move the element or change its parameters, then come back here for the next one. The table is not refreshed after your edits: run the command again to check them. The funnel in each column header filters by value. Move: the move the element would need, positive upwards."/>
                    <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="11"
                               Foreground="#2D5A8A" TextWrapping="Wrap" Text=""/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ShowAllButton" Grid.Column="0" Content="🔍 Show All Listed"
                    Padding="10,3" Height="30"
                    ToolTip="Select in the model every element listed with the current search and filters, and zoom to them"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="AdvancedButton" Content="Advanced Report" Width="130" Height="30"
                        Margin="0,0,10,0"
                        ToolTip="Print the full report in the pyRevit output panel; this window stays open"/>
                <Button x:Name="CloseButton" Content="Close" Width="100" Height="30" IsDefault="True"
                        IsCancel="True" Background="#2D5A8A" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
