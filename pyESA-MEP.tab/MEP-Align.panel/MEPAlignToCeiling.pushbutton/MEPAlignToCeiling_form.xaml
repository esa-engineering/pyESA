<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Align to Ceiling"
        Width="860" Height="560"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⬆️ MEP ALIGN TO CEILING" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLONNA SINISTRA: elementi e categorie -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SECTION: Selection -->
                <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📋 ELEMENTS"/>
                        <TextBlock x:Name="SelectionText" TextWrapping="Wrap" Text="-"/>
                        <TextBlock x:Name="SelectionDetail" Style="{StaticResource HintText}" Text="-"/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Categories -->
                <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="📁 CATEGORIES"/>

                        <Grid Grid.Row="1" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Padding="5,3"/>
                            <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" Width="25"
                                    Margin="5,0,0,0"/>
                        </Grid>

                        <ListBox x:Name="CategoryList" Grid.Row="2" MinHeight="120"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ToolTip="In brackets: elements selected, and those flagged for ceiling installation."/>

                        <Grid Grid.Row="3" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CategoryCount" Style="{StaticResource UnitLabel}"
                                       Margin="0" TextWrapping="Wrap" Text="-"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="SelectAllButton" Content="Select All"
                                        Padding="10,3" Margin="0,0,5,0"/>
                                <Button x:Name="DeselectAllButton" Content="Deselect All"
                                        Padding="10,3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- COLONNA DESTRA: tolleranza, rilevatori, opzioni -->
            <StackPanel Grid.Column="2">

                <!-- SECTION: Tolerance -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📏 TOLERANCE"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tolerance:"/>
                            <TextBox x:Name="ToleranceBox" Grid.Column="1" Style="{StaticResource InputField}"/>
                            <TextBlock x:Name="ToleranceUnit" Grid.Column="2" Style="{StaticResource UnitLabel}"
                                       Text="mm, above and below the insertion point"/>
                        </Grid>
                        <TextBlock x:Name="ToleranceHint" Style="{StaticResource HintText}" Text="-"/>
                    </StackPanel>
                </Border>

                <!-- SECTION: False ceiling detectors -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🔔 FALSE CEILING DETECTORS"/>
                        <TextBlock x:Name="BuzzerText" TextWrapping="Wrap" Text="-"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="They always go to the soffit, and dz_Buzzer is written with the distance to the false ceiling."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Options -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="⚙️ OPTIONS"/>
                        <CheckBox x:Name="IncludeLinks" Margin="0,3"
                                  Content="Look in linked models as well"
                                  ToolTip="Linked elements are a reference only; unloaded, tilted or scaled links are ignored."/>
                        <CheckBox x:Name="SkipConnected" Margin="0,3"
                                  Content="Skip elements connected to others (connectors)"
                                  ToolTip="Moving a connected device may stretch its duct or break the connection."/>
                        <CheckBox x:Name="DryRun" Margin="0,3"
                                  Content="Simulation: do not modify the model"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0"
                    IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
