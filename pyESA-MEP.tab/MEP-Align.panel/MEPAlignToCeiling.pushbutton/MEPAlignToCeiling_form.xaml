<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Align to Ceiling"
        Width="500" Height="760"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⬆️ MEP ALIGN TO CEILING" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel>

                <!-- SECTION: Selection -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📋 ELEMENTS"/>
                        <TextBlock x:Name="SelectionText" TextWrapping="Wrap" Text="-"/>
                        <TextBlock x:Name="SelectionDetail" Style="{StaticResource HintText}" Text="-"/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Categories -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📁 CATEGORIES"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Padding="5,3"
                                     ToolTip="Filter categories by name"/>
                            <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" Width="25"
                                    Margin="5,0,0,0" ToolTip="Clear search"/>
                        </Grid>

                        <ListBox x:Name="CategoryList" MinHeight="60" Height="130"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <Thumb x:Name="ListResizeGrip" Height="8" Cursor="SizeNS"
                               HorizontalAlignment="Stretch" Background="#CCCCCC" Opacity="0.5"
                               ToolTip="Drag to resize the list"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CategoryCount" Style="{StaticResource UnitLabel}"
                                       Margin="0" Text="-"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="SelectAllButton" Content="Select All"
                                        Padding="10,3" Margin="0,0,5,0"/>
                                <Button x:Name="DeselectAllButton" Content="Deselect All"
                                        Padding="10,3"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Only the categories present in your selection are listed: in brackets how many you selected and how many of them are flagged for ceiling installation. Cleared categories end up among the skipped elements in the report."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Target -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🎯 TARGET SURFACE"/>
                        <CheckBox x:Name="UseCeilings" Margin="0,3"
                                  Content="Ceilings: bottom face"/>
                        <CheckBox x:Name="UseFloors" Margin="0,3"
                                  Content="Floor slab soffit, where there is no ceiling"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Only surfaces above the reference level of the element count. A ceiling in the storey always comes first: if it is beyond the tolerance the element is skipped, never pushed up into the void above the ceiling. Stacked floor or ceiling instances in contact, also from different linked models, count as one package and the target is its bottom face."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Tolerance -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📏 TOLERANCE"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tolerance:"/>
                            <TextBox x:Name="ToleranceBox" Grid.Column="1" Style="{StaticResource InputField}"/>
                            <TextBlock x:Name="ToleranceUnit" Grid.Column="2" Style="{StaticResource UnitLabel}"
                                       Text="cm above and below the insertion point"/>
                        </Grid>
                        <TextBlock x:Name="ToleranceHint" Style="{StaticResource HintText}" Text="-"/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Options -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="⚙️ OPTIONS"/>
                        <CheckBox x:Name="IncludeLinks" Margin="0,3"
                                  Content="Look in linked models as well"
                                  ToolTip="Ceilings and slabs are usually in the architectural and structural links. Linked elements are used as a reference only and never modified. A link that is unloaded, tilted or scaled is ignored and listed among the report warnings."/>
                        <CheckBox x:Name="SkipConnected" Margin="0,3"
                                  Content="Skip elements connected to others (connectors)"
                                  ToolTip="Moving an air terminal connected to a duct may stretch the duct or break the connection. With the box clear the elements are processed and the report shows how many connectors each one has."/>
                        <CheckBox x:Name="DryRun" Margin="0,3"
                                  Content="Simulation: do not modify the model"
                                  ToolTip="Computes and reports the result without opening any transaction. Always worth starting here."/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Info -->
                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Foreground="Gray"
                                   Text="ℹ️ HOW IT WORKS"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0"
                                   Text="Only instances with the Yes/No instance parameter u_VIS_Ceiling_installation = Yes are processed. Each one is moved vertically only, so that its insertion point lies on the target surface: plan position and rotation never change. Elements hosted by a ceiling, wall or linked face, pinned ones, those inside a group and those in an inactive design option are skipped. Every selected element appears in the report with its own outcome."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0"
                    IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
