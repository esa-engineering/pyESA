<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turn"
        Width="540" Height="560"
        MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ArrowButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="↪ TURN" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📐 ANGLE OR DIRECTION"/>
                        <Grid x:Name="AngleArea">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="SavedText" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="AnglePanel" Margin="0,0,0,6"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Custom:"/>
                                    <TextBox Grid.Column="1" x:Name="CustomBox" Style="{StaticResource InputField}"/>
                                    <TextBlock Grid.Column="2" x:Name="RangeText" Style="{StaticResource UnitLabel}"/>
                                </Grid>
                            </StackPanel>
                            <Line Grid.Column="1" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" Stroke="#CCCCCC"
                                  StrokeThickness="1" StrokeDashArray="4 3" Margin="12,0"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Row="0" Grid.Column="1" x:Name="DirUp" Style="{StaticResource ArrowButton}"
                                            Content="↑" ToolTip="Turn towards the top of the view"/>
                                    <Button Grid.Row="1" Grid.Column="0" x:Name="DirLeft" Style="{StaticResource ArrowButton}"
                                            Content="←" ToolTip="Turn towards the left of the view"/>
                                    <Rectangle Grid.Row="1" Grid.Column="1" Width="14" Height="14" Stroke="Gray"
                                               StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Grid.Row="1" Grid.Column="2" x:Name="DirRight" Style="{StaticResource ArrowButton}"
                                            Content="→" ToolTip="Turn towards the right of the view"/>
                                    <Button Grid.Row="2" Grid.Column="1" x:Name="DirDown" Style="{StaticResource ArrowButton}"
                                            Content="↓" ToolTip="Turn towards the bottom of the view"/>
                                </Grid>
                                <TextBlock Style="{StaticResource UnitLabel}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Text="direction in the view"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="LengthHeader" Style="{StaticResource SectionHeader}" Text="📏 LENGTH AND SLOPE"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Length:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" x:Name="LengthUnit" Style="{StaticResource UnitLabel}"
                                       Text="mm (new run after the elbow)"/>
                        </Grid>
                        <StackPanel x:Name="SlopePanel">
                            <RadioButton x:Name="KeepSlope" GroupName="Slope" Margin="0,6,0,3"
                                         Content="Keep the slope of the original run"/>
                            <RadioButton x:Name="Horizontal" GroupName="Slope" Margin="0,3"
                                         Content="Make the new run horizontal"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🎯 ALIGN TO AN ELEMENT"/>
                        <CheckBox x:Name="AlignCheck" Margin="0,3"
                                  Content="After the elbow, run parallel to an element I click"/>
                        <TextBlock x:Name="AlignHint" Style="{StaticResource HintText}" Margin="20,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock x:Name="InfoText" Style="{StaticResource HintText}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Use custom" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
