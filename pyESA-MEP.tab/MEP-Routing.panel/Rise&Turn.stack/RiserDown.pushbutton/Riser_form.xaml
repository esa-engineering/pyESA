<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riser Up"
        Width="440" Height="480"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="⬆ RISER UP" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📏 RISER HEIGHT"/>

                        <RadioButton x:Name="ModeLength" GroupName="Mode" Content="Length above the selected end"/>
                        <Grid Margin="20,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Length:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm"/>
                        </Grid>

                        <RadioButton x:Name="ModeLevel" GroupName="Mode" Content="Up to a level (plus offset)"/>
                        <Grid Margin="20,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Level:" Margin="0,5"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LevelCombo" Style="{StaticResource ComboStyle}" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Offset:" Margin="0,5"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                                <TextBox x:Name="OffsetBox" Style="{StaticResource InputField}"/>
                                <TextBlock Style="{StaticResource UnitLabel}" Text="mm (positive = above the level)"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📐 INCLINED RUN FIRST (OPTIONAL)"/>
                        <CheckBox x:Name="SlopeCheck" Content="Add an inclined run before the vertical run"/>
                        <Grid Margin="20,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Angle:"/>
                            <TextBox Grid.Column="1" x:Name="SlopeAngleBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="degrees from the horizontal (5 to 85)"/>
                        </Grid>
                        <Grid Margin="20,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Length:"/>
                            <TextBox Grid.Column="1" x:Name="SlopeLengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm along the inclined run"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,3,0,0"
                                   Text="Needs a horizontal free end. The run goes on in the direction of the pipe, rising at this angle, then the vertical run. The elbows are placed automatically."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource HintText}" x:Name="HintBlock"
                               Text="After OK, click each pipe, duct, cable tray or conduit near the free end you want to extend. The riser starts from the nearest free end and goes straight up, with an elbow where needed. Press ESC to finish and get the report."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
