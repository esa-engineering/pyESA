<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizontal Branch"
        Width="480" Height="560"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⇢ HORIZONTAL BRANCH" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📏 OFFSET AND ANGLE"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Vertical offset:"/>
                            <TextBox Grid.Column="1" x:Name="OffsetBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}"
                                       Text="mm (+ up, - down, 0 = no change of level)"/>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Angle of the inclined run:" Margin="0,8,0,4"/>
                        <WrapPanel Margin="20,0,0,0">
                            <RadioButton x:Name="Ang90" GroupName="Angle" Content="90°  (vertical)" Margin="0,0,20,6"/>
                            <RadioButton x:Name="Ang45" GroupName="Angle" Content="45°" Margin="0,0,20,6"/>
                            <RadioButton x:Name="Ang30" GroupName="Angle" Content="30°" Margin="0,0,20,6"/>
                        </WrapPanel>
                        <Grid Margin="20,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="AngCustom" GroupName="Angle" Content="Custom:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="CustomBox" Style="{StaticResource InputField}" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="degrees from the horizontal (5 to 90)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="↔ HORIZONTAL RUN"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Length:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}"
                                       Text="mm, after the change of level (from the elbow)"/>
                        </Grid>
                        <CheckBox x:Name="ReturnCheck" Margin="0,8,0,0"
                                  Content="Return to the starting level after the horizontal run"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,3,0,0"
                                   Text="A second inclined run, at the same angle and in the opposite direction, brings the branch back to the level it started from, followed by a last horizontal run of the same length as the first. Needs an offset other than 0."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5" Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Order of the branch: a short stub with the tee or tap, then the inclined run at the chosen angle up or down to the offset, then the horizontal run of the length above. Ducts and cable trays keep the tee on the horizontal stub before the change of level, as needed."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
