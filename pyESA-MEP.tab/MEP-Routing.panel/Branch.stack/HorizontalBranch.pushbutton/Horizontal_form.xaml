<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizontal Branch"
        Width="500" Height="640"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⇢ HORIZONTAL BRANCH" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📏 BRANCH"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Angle from the horizontal:" Margin="0,0,0,4"/>
                        <WrapPanel Margin="20,0,0,0">
                            <RadioButton x:Name="Ang0" GroupName="Angle" Content="0°  (side, no change of level)" Margin="0,0,20,6"/>
                            <RadioButton x:Name="Ang15" GroupName="Angle" Content="15°" Margin="0,0,20,6"/>
                            <RadioButton x:Name="Ang22" GroupName="Angle" Content="22.5°" Margin="0,0,20,6"/>
                            <RadioButton x:Name="Ang30" GroupName="Angle" Content="30°" Margin="0,0,20,6"/>
                            <RadioButton x:Name="Ang45" GroupName="Angle" Content="45°" Margin="0,0,20,6"/>
                            <RadioButton x:Name="Ang90" GroupName="Angle" Content="90°  (vertical)" Margin="0,0,20,6"/>
                        </WrapPanel>
                        <CheckBox x:Name="ReturnCheck" Margin="20,2,0,0"
                                  Content="Return to the starting level after the horizontal run"/>
                        <Grid Margin="0,8,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Vertical offset:"/>
                            <TextBox Grid.Column="1" x:Name="OffsetBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm (+ up, - down)"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Horizontal length:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, after the change of level"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🌬 DUCTS"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Junction:"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="DuctTap" GroupName="DuctJunction" Content="Tap" Margin="0,0,20,0"/>
                                <RadioButton x:Name="DuctTee" GroupName="DuctJunction" Content="Tee"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Branch size:" Margin="0,8,0,4"/>
                        <RadioButton x:Name="SizeSame" GroupName="DuctSize" Content="Same size as the duct" Margin="20,0,0,6"/>
                        <Grid Margin="20,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" x:Name="SizeRect" GroupName="DuctSize" Content="Rectangular:"
                                         VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="DuctWidthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="x" Margin="6,0,6,0"/>
                            <TextBox Grid.Column="3" x:Name="DuctHeightBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource UnitLabel}" Text="mm, W x H"/>
                        </Grid>
                        <Grid Margin="20,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" x:Name="SizeRound" GroupName="DuctSize" Content="Circular:"
                                         VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="DuctDiameterBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, diameter"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="Pipes and cable trays keep the junction set in Vertical Branch."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5" Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Ducts at 90°: from the top face (offset +) or the bottom face (offset -). SHIFT + CLICK: last settings, no window."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
