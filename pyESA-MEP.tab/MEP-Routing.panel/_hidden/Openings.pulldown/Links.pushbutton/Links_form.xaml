<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openings Links"
        Width="900" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔗 OPENINGS: TYPES TO CHECK" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                    Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource HintText}" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="Tick the types to check for openings. REI: Auto uses the REI rules of Setup (run Setup first to set them; the count is how many elements match), or force the whole type. Structural comes from the category (Structural Framing, Structural Columns, ...). The list is saved in the model and used by Place and Refresh."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="🔍" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" VerticalContentAlignment="Center"/>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="TypeList" HorizontalContentAlignment="Stretch"/>
                </Grid>
            </Border>

            <Thumb Grid.Row="2" Height="6" Cursor="SizeNS" Margin="0,2,0,2"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button x:Name="SelectAllButton" Content="Select All" Width="100" Height="26" Margin="0,0,8,0"/>
                <Button x:Name="DeselectAllButton" Content="Deselect All" Width="100" Height="26"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Save" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
