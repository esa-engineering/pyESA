<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pipe Branch"
        Width="480" Height="680"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⊢ PIPE BRANCH" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource HintText}"/>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🧭 SIDE OF THE BRANCH"/>
                        <Grid HorizontalAlignment="Center" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <RadioButton Grid.Row="0" Grid.Column="1" x:Name="DirUp" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="⬆ Up"/>
                            <RadioButton Grid.Row="1" Grid.Column="0" x:Name="DirLeft" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="⬅ Left"/>
                            <Border Grid.Row="1" Grid.Column="1" Width="46" Height="46" CornerRadius="23"
                                    BorderBrush="#2D5A8A" BorderThickness="3" Background="#E8E8E8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="riser" FontSize="10" Foreground="Gray"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <RadioButton Grid.Row="1" Grid.Column="2" x:Name="DirRight" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="Right ➡"/>
                            <RadioButton Grid.Row="2" Grid.Column="1" x:Name="DirDown" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="⬇ Down"/>
                        </Grid>
                        <RadioButton x:Name="DirCustom" GroupName="Dir" HorizontalAlignment="Center"
                                     Margin="0,6,0,0" Content="🖱 Custom: click a direction in the view"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="As seen on screen in the current plan view (the riser seen from above). With Custom, after OK you click one point in the view: the branch goes from the pipe axis towards that point (one direction for all the selected pipes, taken from the first pipe)."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="↕ ELEVATION OF THE BRANCH"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Level:"/>
                            <ComboBox Grid.Column="1" x:Name="LevelCombo" Style="{StaticResource ComboStyle}"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Offset:"/>
                            <TextBox Grid.Column="1" x:Name="OffsetBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm from the level to the branch axis"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="If the elevation is above or below the end of a riser, the riser is extended and a tee is placed (use the Turn commands for curves). Whatever is already connected to that end is disconnected: the final configuration has priority."/>
                        <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5" Background="#F8F8F8"
                                Padding="8" Margin="0,8,0,0">
                            <TextBlock x:Name="ConnectionText" Style="{StaticResource HintText}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📐 BRANCH"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Length:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, from the riser axis"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Junction:"/>
                            <ComboBox Grid.Column="1" x:Name="JunctionCombo" Style="{StaticResource ComboStyle}"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Riser past the tee:"/>
                            <TextBox Grid.Column="1" x:Name="StubBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, only when the riser is extended"/>
                        </Grid>
                        <CheckBox x:Name="ReduceBox" Margin="0,8,0,0"
                                  Content="Branch one size smaller than the riser"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,3,0,0"
                                   Text="Uses the next smaller nominal diameter of the pipe segment set in the Routing Preferences of the type. If the riser is already at the smallest size, the branch keeps its size and the report says so. The horizontal mode asks it at every start."/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="The branch is horizontal. Tee on pipes by default; a tee splits the riser, a tap does not. The branch keeps the type of the riser."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
