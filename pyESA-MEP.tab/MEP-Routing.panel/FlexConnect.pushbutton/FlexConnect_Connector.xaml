<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlexConnect" Width="520" Height="320" MinWidth="440" MinHeight="260"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🔗 FLEXCONNECT" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            <!-- icona info, uguale a quella della finestra delle impostazioni -->
            <Border Width="22" Height="22" BorderBrush="#444444" BorderThickness="1.5" CornerRadius="3"
                    Background="Transparent" Cursor="Help" HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="120000">
                <TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border.ToolTip>
                    <ToolTip MaxWidth="560">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="HOW TO USE" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="The equipment has several free connectors of the same system type. Choose the one the flex connects to."/>
                                <LineBreak/>
                                <Run Text="Double click a row, or select it and press OK. Cancel skips this connection and the command goes on."/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="THE LIST" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Each row shows the Connector Description set in the family, the system type, the size and the distance from the pipe or duct. The nearest connector is selected at the start."/>
                            </TextBlock>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
            </Border>
        </Grid>
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="📍 EQUIPMENT CONNECTOR"/>
                <ListBox x:Name="ConnectorList" Grid.Row="1"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
