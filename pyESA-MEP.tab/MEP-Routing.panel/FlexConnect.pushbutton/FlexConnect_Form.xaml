<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlexConnect" Width="520" Height="500" MinWidth="480" MinHeight="470"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🔗 FLEXCONNECT" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            <!-- icona info: il tooltip "How to use" resta aperto finche' il mouse e' sopra -->
            <Border Width="22" Height="22" BorderBrush="#444444" BorderThickness="1.5" CornerRadius="3"
                    Background="Transparent" Cursor="Help" HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="120000">
                <TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border.ToolTip>
                    <ToolTip MaxWidth="560">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="HOW TO USE" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="1. CLICK runs with the last settings. SHIFT + CLICK opens this window."/>
                                <LineBreak/>
                                <Run Text="2. Pick the pipe or duct and the equipment or air terminal, in any order. A pipe or duct selected beforehand counts as the first pick."/>
                                <LineBreak/>
                                <Run Text="3. For a duct, the click on the duct is a point: it decides where the flex connects."/>
                                <LineBreak/>
                                <Run Text="4. The command stays active after each connection. Press Esc to end it. If reducers were added, one message tells you when the command ends."/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="PIPES" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="The flex goes from the free end of the pipe to the nearest free connector of the same system type, with the size of the pipe. If the equipment connector is different, a reducer and a short pipe are added. The insulation of the pipe is copied."/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="DUCTS" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="The flex has the size of the air terminal connector, which must be round."/>
                                <LineBreak/>
                                <Run Text="Click the end face of a free duct end to connect to the end (a transition is added if shape or size differ). Click the side of the duct to make a tap at mid height."/>
                                <LineBreak/>
                                <Run Text="After each connection the command asks for the next terminal and point on the same duct. The insulation of the duct is copied."/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" Foreground="#2D5A8A" Text="SETTINGS" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Flex type is separate for pipes and ducts. Duct tap fitting: the first item uses the routing preferences of the duct type. Reducer offset: distance of the reducer from the connector, used only when sizes differ. Choose the connector: asks which one to use when several of the same system type are free."/>
                            </TextBlock>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
            </Border>
        </Grid>
        <StackPanel Grid.Row="1">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="🔧 PIPES"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Flex pipe type"/>
                        <ComboBox x:Name="TypeCombo" Grid.Column="1" Style="{StaticResource ComboStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="💨 DUCTS"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Flex duct type"/>
                        <ComboBox x:Name="DuctTypeCombo" Grid.Column="1" Style="{StaticResource ComboStyle}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Duct tap fitting"/>
                        <ComboBox x:Name="TapCombo" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                  ToolTip="Fitting of the side tap on a duct. The first item uses the routing preferences of the duct type."/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="⚙ GENERAL"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Reducer offset"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    ToolTip="Distance of the reducer from the equipment connector. Used only when the sizes differ.">
                            <TextBox x:Name="GapBox" Style="{StaticResource InputField}"/>
                            <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="AskConnectorBox" Margin="0,8,0,0"
                              Content="Choose the connector if several are free"
                              ToolTip="Asks which equipment connector to use when several of the same system type are free."/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
