<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Overpass"
        Width="560" Height="640"
        MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚠ CLASH OVERPASS" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- azione: sopra / sotto / niente, distanza, unione, angolo delle salite -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="↕ ACTION"/>
                        <RadioButton x:Name="ActionOver" GroupName="Action" Margin="0,3" Content="Pass over the obstacle"/>
                        <RadioButton x:Name="ActionUnder" GroupName="Action" Margin="0,3" Content="Pass under the obstacle"/>
                        <RadioButton x:Name="ActionNone" GroupName="Action" Margin="0,3"
                                     Content="Report only (change nothing, list the clashes in the report)"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Clearance:"/>
                            <TextBox Grid.Column="1" x:Name="ClearanceBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, edge to edge from the obstacle"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Merge overpasses:"/>
                            <TextBox Grid.Column="1" x:Name="MergeBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, minimum run left between two overpasses"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,0"
                                   Text="Ticked obstacles on the same run get one single overpass when the run left at its elevation between them would be shorter than this. 0 = merge only when the overpasses would touch."/>
                        <Grid Margin="0,8,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Leg angle:"/>
                            <ComboBox Grid.Column="1" x:Name="AngleCombo" Style="{StaticResource ComboStyle}"/>
                        </Grid>
                        <Grid Margin="20,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Custom:"/>
                            <TextBox Grid.Column="1" x:Name="AngleBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="degrees (0 - 90)"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="The leg angle is measured from the horizontal: 90 = vertical legs. Rises and drops start before the obstacle, so it is cleared by the clearance."/>
                    </StackPanel>
                </Border>

                <!-- avviso: numero di interferenze trovate, risolte tutte con le impostazioni sopra -->
                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="ClashHeader" Style="{StaticResource SectionHeader}" Text="⚠ CLASHES FOUND"/>
                        <TextBlock x:Name="ClashText" Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Border>

                <!-- tipo di controllo: cambiandolo la ricerca si ripete -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🔎 CLASH DETECTION"/>
                        <RadioButton x:Name="ScopeDistribution" GroupName="Scope" Margin="0,3"
                                     Content="Distribution elements only"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,4"
                                   Text="Pipes, ducts, cable trays, conduits, flex pipes and ducts, their fittings and accessories, insulation and lining."/>
                        <RadioButton x:Name="ScopeAll" GroupName="Scope" Margin="0,3" Content="Everything"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,0"
                                   Text="All model elements of this file: also structure, walls, floors, ceilings, equipment and generic models. Linked models are not checked."/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="Changing the option searches the clashes again and reloads this window. The choice is kept for the next time."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Stop" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
