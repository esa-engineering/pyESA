<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tab Visibility"
        Width="420" Height="540"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🗂 TAB VISIBILITY" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="ADD-IN TABS (checked = shown)"/>
                <Border DockPanel.Dock="Top" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="8" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="The default Revit tabs are not listed. To show or hide them go to File > Options > User Interface > Configure. The pyESA tab is not listed either: hiding it would leave this tool out of reach."/>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <CheckBox x:Name="RememberCheck" Content="Keep these tabs hidden when Revit restarts"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="20,3,0,0"
                               Text="Unticked: the change lasts until Revit is closed, and the tabs saved before are forgotten."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="SelectAllButton" Content="Show all" Padding="10,3" Margin="0,0,5,0"/>
                    <Button x:Name="DeselectAllButton" Content="Hide all" Padding="10,3"/>
                </StackPanel>
                <ListBox x:Name="TabList" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Apply" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
