<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allineamento elementi MEP alle partizioni verticali"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF4F4F4"
        FontFamily="Segoe UI"
        FontSize="12">

    <!--
        L'altezza massima viene imposta da codice sull'area di lavoro dello
        schermo: con SizeToContent="Height" e senza limite la finestra cresce
        oltre il monitor su schermi piccoli o con scalatura alta. Oltre quel
        limite subentra lo ScrollViewer, mentre i pulsanti restano ancorati
        in basso e sempre raggiungibili.
    -->

    <Window.Resources>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,6,10,8"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF707070"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- Le spiegazioni lunghe stanno nei tooltip: restano disponibili
             senza far crescere la finestra. -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>

                <TextBlock TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Foreground="#FF404040">
                    Per ogni elemento MEP selezionato cerca la partizione verticale piu'
                    vicina, lo porta a filo della sua faccia e lo ruota perpendicolare
                    alla parete. Oltre la tolleranza l'elemento viene saltato. La quota
                    non viene mai modificata.
                </TextBlock>

                <!-- ============ Elementi da allineare ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="Elementi da allineare" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <TextBlock x:Name="tb_walls_info"
                                   TextWrapping="Wrap"
                                   Text="-"/>
                        <TextBlock x:Name="tb_walls_extent"
                                   Style="{StaticResource HintStyle}"
                                   Text="-"/>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 1. Categorie ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="1. Categorie da allineare" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>

                        <Border BorderBrush="#FFABADB3" BorderThickness="1" Background="White"
                                Padding="6,4,6,4">
                            <StackPanel x:Name="sp_categories"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="btn_cat_all"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Content="Tutte"
                                    Click="on_select_all"/>
                            <Button x:Name="btn_cat_none"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Content="Nessuna"
                                    Click="on_select_none"/>
                            <TextBlock x:Name="tb_cat_count"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Foreground="#FF707070"
                                       Text="-"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   ToolTipService.ShowDuration="30000"
                                   ToolTip="Fra parentesi il numero di elementi di quella categoria presenti nella selezione corrente. Togliendo la spunta a una categoria i suoi elementi non vengono elaborati, ma compaiono comunque fra gli ignorati del resoconto con il motivo: non spariscono in silenzio."
                                   Text="Fra parentesi quanti ne hai selezionati. Le categorie senza spunta finiscono fra gli ignorati del resoconto."/>

                    </StackPanel>
                </GroupBox>

                <!-- ============ 2. Tolleranza ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="2. Tolleranza" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Allinea solo se la partizione e' entro"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="tb_threshold"
                                     Width="60"
                                     Height="22"
                                     Margin="8,0,6,0"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="30"/>
                            <TextBlock Text="cm" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   ToolTipService.ShowDuration="30000"
                                   ToolTip="La distanza e' misurata in pianta fra il punto di inserimento dell'elemento e la faccia della partizione piu' vicina, non il suo asse. Gli elementi che cadono dentro lo spessore della partizione hanno distanza negativa e rientrano quindi sempre. Un elemento piu' lontano viene saltato e compare nel resoconto con la distanza misurata e di quanto ha sforato."
                                   Text="Misurata dalla faccia, non dall'asse. Oltre la tolleranza l'elemento viene saltato e riportato con la distanza misurata."/>

                    </StackPanel>
                </GroupBox>

                <!-- ============ 3. Opzioni ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="3. Opzioni" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>

                        <CheckBox x:Name="chk_rotate"
                                  IsChecked="True"
                                  Content="Ruota gli elementi perpendicolari alla partizione"
                                  ToolTip="Viene applicata la rotazione piu' piccola possibile, al massimo 90 gradi: l'elemento non viene mai ribaltato di 180 gradi. Di conseguenza un elemento montato al contrario viene reso perpendicolare ma non raddrizzato. Togliendo la spunta viene applicata la sola traslazione."/>

                        <CheckBox x:Name="chk_links"
                                  IsChecked="True"
                                  Content="Cerca le partizioni anche nei modelli collegati"
                                  ToolTip="Nei progetti MEP l'architettonico e' quasi sempre un collegamento. I muri collegati vengono usati solo come riferimento e non vengono mai modificati. Un collegamento scaricato, inclinato, speculare o in scala viene ignorato e il motivo compare fra gli avvisi del resoconto."/>

                        <CheckBox x:Name="chk_skip_connected"
                                  Content="Salta gli elementi collegati ad altri (connettori)"
                                  ToolTip="Spostare un terminale aria collegato a un canale puo' far allungare il canale o rompere la connessione. Lasciando la casella vuota gli elementi vengono elaborati e il numero di connettori collegati compare in una colonna del resoconto."/>

                        <CheckBox x:Name="chk_dryrun"
                                  Content="Simulazione: non modificare il modello"
                                  ToolTip="Calcola e riporta il risultato senza aprire alcuna transazione, quindi senza modificare il modello. Conviene sempre partire da qui."/>

                    </StackPanel>
                </GroupBox>

                <!-- ============ Avvertenze ============ -->
                <Border Background="#FFFFF8E1"
                        BorderBrush="#FFE6C86E"
                        BorderThickness="1"
                        Padding="10,7,10,7"
                        Margin="0,0,0,2"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="Lo spostamento porta il punto di inserimento esattamente sulla faccia della partizione: se la famiglia ha l'origine al centro del proprio ingombro invece che sul retro, l'elemento risulta per meta' dentro il muro. Le colonne distanza prima e distanza dopo del resoconto servono a verificarlo. Gli elementi gia' ospitati da un muro, quelli bloccati, quelli in un gruppo e quelli di un'opzione di progetto non attiva vengono ignorati.">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#FF6B5200"
                               Text="Ogni elemento selezionato compare nel resoconto con il suo esito: nessuno viene ignorato in silenzio. Conviene eseguire prima una simulazione."/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ Pulsanti, sempre visibili ============ -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="btn_cancel"
                    Content="Annulla"
                    Style="{StaticResource ActionButtonStyle}"
                    IsCancel="True"
                    Click="on_cancel"/>
            <Button x:Name="btn_run"
                    Content="Esegui"
                    Style="{StaticResource ActionButtonStyle}"
                    IsDefault="True"
                    Click="on_run"/>
        </StackPanel>

    </Grid>
</Window>
