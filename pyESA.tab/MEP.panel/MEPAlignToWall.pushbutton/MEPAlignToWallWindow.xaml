<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align MEP elements to vertical partitions"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF4F4F4"
        FontFamily="Segoe UI"
        FontSize="12">

    <!--
        The maximum height is imposed from code, from the screen work area:
        with SizeToContent="Height" and no limit the window grows past the
        monitor on small screens or with high display scaling. Beyond that
        limit the ScrollViewer takes over, while the buttons stay anchored at
        the bottom and always reachable.
    -->

    <Window.Resources>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,6,10,8"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF707070"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- Long explanations live in the tooltips: they stay available
             without making the window grow. -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>

                <TextBlock TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Foreground="#FF404040">
                    For every selected MEP element the tool looks for the nearest vertical
                    partition and brings the element flush with one of its two faces. Which
                    face is decided by the family front, read from its Room Calculation
                    Point. The element travels along that same direction, and where several
                    walls touch each other the target is the outermost face of the whole
                    package. Beyond the tolerance the element is skipped. The element is
                    then squared up perpendicular to the face, by at most 5 degrees.
                    Elevation is never changed.
                </TextBlock>

                <!-- ============ Elements to align ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="Elements to align" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <TextBlock x:Name="tb_walls_info"
                                   TextWrapping="Wrap"
                                   Text="-"/>
                        <TextBlock x:Name="tb_walls_extent"
                                   Style="{StaticResource HintStyle}"
                                   Text="-"/>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 1. Categories ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="1. Categories to align" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>

                        <Border BorderBrush="#FFABADB3" BorderThickness="1" Background="White"
                                Padding="6,4,6,4">
                            <StackPanel x:Name="sp_categories"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="btn_cat_all"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Content="All"
                                    Click="on_select_all"/>
                            <Button x:Name="btn_cat_none"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Content="None"
                                    Click="on_select_none"/>
                            <TextBlock x:Name="tb_cat_count"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Foreground="#FF707070"
                                       Text="-"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   ToolTipService.ShowDuration="30000"
                                   ToolTip="Only the categories actually present in your selection are listed: a handled category with no element in the selection is not shown at all. In brackets, how many elements of that category you selected. Clearing a category means its elements are not processed, but they still appear among the skipped ones in the report with their reason: they do not vanish silently."
                                   Text="Only the categories present in your selection are listed, with how many you selected. Cleared categories end up among the skipped elements in the report."/>

                    </StackPanel>
                </GroupBox>

                <!-- ============ 2. Tolerance ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="2. Tolerance" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Align only if the partition is within"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="tb_threshold"
                                     Width="60"
                                     Height="22"
                                     Margin="8,0,6,0"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Text="30"/>
                            <TextBlock Text="cm" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   ToolTipService.ShowDuration="30000"
                                   ToolTip="The distance is measured in plan between the element insertion point and the face of the nearest partition, not its location line. Elements that fall inside the partition thickness have a negative distance and therefore always qualify. An element farther than this is skipped and appears in the report with its measured distance and by how much it overshot."
                                   Text="Measured from the face, not from the axis. Beyond the tolerance the element is skipped and reported with its measured distance."/>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   ToolTipService.ShowDuration="30000"
                                   ToolTip="To work out which way the device is looking, the tool draws from the insertion point a line twice as long as this tolerance, in the direction of the family Room Calculation Point. If the line hits the partition, the device is facing it instead of turning away from it, and is therefore carried to the opposite face: the move is then the measured distance plus the wall thickness. Walls more than 5 degrees off the perpendicular to the front are treated as parallel to the line and excluded, because the device has them alongside rather than in front: if none is left, the element is skipped and reported rather than aligned to the wrong reference. On families with no Room Calculation Point, or that never moved it off the origin, there is no line and the nearest face still applies. The Front column of the report says which criterion decided, element by element. The move runs along that same line rather than along the wall normal, but within the 5 degree cone the two directions barely differ. Where several wall instances touch, the target is the outermost face of the whole package."
                                   Text="The same tolerance drives the line that identifies the family front. Walls the device has alongside it are excluded: if none is left in front, the element is skipped and reported."/>

                    </StackPanel>
                </GroupBox>

                <!-- ============ 3. Options ============ -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="3. Options" Style="{StaticResource SectionTitleStyle}"/>
                    </GroupBox.Header>
                    <StackPanel>

                        <CheckBox x:Name="chk_links"
                                  IsChecked="True"
                                  Content="Look for partitions in linked models as well"
                                  ToolTip="In MEP projects the architectural model is almost always a link. Linked walls are used as a reference only and are never modified. A link that is unloaded, tilted, mirrored or scaled is ignored, and the reason appears among the report warnings."/>

                        <CheckBox x:Name="chk_skip_connected"
                                  Content="Skip elements connected to others (connectors)"
                                  ToolTip="Moving an air terminal connected to a duct may stretch the duct or break the connection. Leaving the box clear means the elements are processed and the number of connected connectors appears in a column of the report."/>

                        <CheckBox x:Name="chk_dryrun"
                                  Content="Simulation: do not modify the model"
                                  ToolTip="Computes and reports the result without opening any transaction, so without modifying the model. Always worth starting here."/>

                    </StackPanel>
                </GroupBox>

                <!-- ============ Warnings ============ -->
                <Border Background="#FFFFF8E1"
                        BorderBrush="#FFE6C86E"
                        BorderThickness="1"
                        Padding="10,7,10,7"
                        Margin="0,0,0,2"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="The move brings the insertion point exactly onto the partition face: if the family has its origin at the centre of its own extents rather than at the back, the element ends up half inside the wall. The distance before and distance after columns of the report are there to check that. Elements already hosted by a wall, pinned ones, those inside a group and those in an inactive design option are ignored.">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#FF6B5200"
                               Text="Squaring up never exceeds 5 degrees: an element that is genuinely askew is skipped, not rotated. Every selected element appears in the report with its own outcome: none is ignored silently. Worth running a simulation first."/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ Buttons, always visible ============ -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="btn_cancel"
                    Content="Cancel"
                    Style="{StaticResource ActionButtonStyle}"
                    IsCancel="True"
                    Click="on_cancel"/>
            <Button x:Name="btn_run"
                    Content="Run"
                    Style="{StaticResource ActionButtonStyle}"
                    IsDefault="True"
                    Click="on_run"/>
        </StackPanel>

    </Grid>
</Window>
