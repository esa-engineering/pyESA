<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Price list columns"
        Height="760" Width="980"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="📑 Price list columns"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SECTION: Sheet -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📄 SHEET" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="txt_file" Style="{StaticResource HintText}" Text=""/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sheet:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cbo_sheet" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                  ToolTip="Sheet of the workbook that holds the unit price list"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="Rows without a price code, the header row and rows with only the code filled (titles, chapter headings) are skipped. A repeated code: the first row wins."/>
                </StackPanel>
            </Border>

            <!-- SECTION: Columns -->
            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🔗 COLUMNS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Pick the column of every field. The price book code is required; the other fields can be left as (none). Every price code of the model is looked up in the code column."/>
                    <Grid x:Name="grd_fields" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="btn_detect" Content="Detect from Headers" Padding="10,3" Margin="0,0,5,0"
                                ToolTip="Map the columns whose header has a known name (Codice, Descrizione, UM, Prezzo...)"/>
                        <Button x:Name="btn_positions" Content="A to E" Padding="10,3"
                                ToolTip="Code in A, short description in B, description in C, unit in D, unit price in E (chapter, subchapter, EPU item No., price book in F to I)"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SECTION: Preview -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="txt_preview" Text="👁️ PREVIEW" Style="{StaticResource SectionHeader}"/>
                <DataGrid x:Name="dg_preview" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="All"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#E8E8E8" VerticalGridLinesBrush="#E8E8E8"
                          HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btn_cancel" Content="Cancel" Width="100" Height="30"
                    Margin="0,0,10,0"/>
            <Button x:Name="btn_ok" Content="OK" Width="100" Height="30"
                    IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
