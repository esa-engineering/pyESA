<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bill of quantities layout"
        Height="560" Width="820"
        MinHeight="440" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🧮 Bill of quantities layout"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SECTION: Available fields -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 AVAILABLE FIELDS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                               Text="Add a field to the rows or, for WBS levels, to the columns. Double click adds it to the rows."/>
                    <ListBox x:Name="lst_available" Grid.Row="2" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="btn_add_rows" Content="Add to Rows" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_add_columns" Content="Add to Columns" Padding="10,3"
                                ToolTip="Only WBS levels can go on the columns"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION: Rows -->
            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="↕️ ROWS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                               Text="Grouping levels of the rows, from the outermost down. Empty: a flat list of items."/>
                    <ListBox x:Name="lst_rows" Grid.Row="2"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="btn_rows_up" Content="Up" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_rows_down" Content="Down" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_rows_remove" Content="Remove" Padding="10,3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION: Columns -->
            <Border Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="↔️ COLUMNS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                               Text="WBS levels shown as columns: one column per combination of values, in this order."/>
                    <ListBox x:Name="lst_columns" Grid.Row="2"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="btn_columns_up" Content="Up" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_columns_down" Content="Down" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_columns_remove" Content="Remove" Padding="10,3"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- INFO -->
        <Border Grid.Row="2" BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1"
                CornerRadius="5" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="ℹ️ HOW THE LAYOUT WORKS"
                           Style="{StaticResource SectionHeader}" Foreground="Gray"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
                    <Run Text="The order of insertion is the order of grouping; Up and Down change it."/>
                    <LineBreak/>
                    <Run Text="A WBS level on the columns no longer splits the items into rows: each item and every group row shows its amount in every combination of the column levels. Quantity and Amount stay the totals."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button x:Name="btn_default" Content="Restore Default" Padding="10,3" HorizontalAlignment="Left"
                    ToolTip="Rows: Chapter, Subchapter. No columns."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_cancel" Content="Cancel" Width="100" Height="30"
                        Margin="0,0,10,0"/>
                <Button x:Name="btn_ok" Content="OK" Width="100" Height="30"
                        IsDefault="True"
                        Background="#2D5A8A" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
