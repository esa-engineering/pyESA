<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Quantity Takeoff"
        Height="800" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8E8E8"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🧮 MEP Quantity Takeoff"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- SECTION: Settings -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚙️ SETTINGS" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Price list:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_price_list" Grid.Row="0" Grid.Column="1" Padding="5,3" Margin="0,2"
                                 IsReadOnly="True" Background="#F8F8F8"
                                 ToolTip="Shared price list: .json (editable with Edit...), .xlsx / .csv (read only, maintained in Excel) or a PriMus .xpwe file (read only); sheet and columns are chosen with Columns..."/>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btn_price_list" Content="Browse..." Padding="10,3" Margin="5,2,0,2"/>
                            <Button x:Name="btn_price_columns" Content="Columns..." Padding="10,3" Margin="5,2,0,2"
                                    IsEnabled="False"
                                    ToolTip="Excel / CSV / PriMus price list: choose the sheet and the column of every field (for a PriMus file, also which of its five prices to use)"/>
                            <Button x:Name="btn_price_edit" Content="Edit..." Padding="10,3" Margin="5,2,0,2"
                                    ToolTip="Edit the price list (.json). An Excel, CSV or PriMus price list is imported into a new .json price list."/>
                            <Button x:Name="btn_price_reload" Content="Reload" Padding="10,3" Margin="5,2,0,2"
                                    ToolTip="Read the price list again (after editing it in Excel or by someone else)"/>
                            <Button x:Name="btn_price_clear" Content="✕" Width="25" Margin="5,2,0,2"
                                    ToolTip="Work without a price list"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Project file:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_project_file" Grid.Row="1" Grid.Column="1" Padding="5,3" Margin="0,2"
                                 IsReadOnly="True" Background="#F8F8F8"
                                 ToolTip="JSON file with descriptions, units and unit prices of this project. The model is never written."/>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btn_project_file" Content="Change..." Padding="10,3" Margin="5,2,0,2"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Phase:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cbo_phase" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                  ToolTip="Elements are counted in this phase"/>
                        <TextBlock Grid.Column="3" Text="Phase status:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cbo_phase_status" Grid.Column="4" Style="{StaticResource ComboStyle}"
                                  ToolTip="New: only elements created in the phase. New + Existing: also elements carried over from earlier phases. Demolished elements are never counted."/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="WBS:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txt_wbs" Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text=""/>
                        <Button x:Name="btn_wbs" Grid.Column="2" Content="WBS Levels..." Padding="10,3" Margin="5,2,0,2"
                                ToolTip="Choose the parameters of the WBS levels used to group the bill of quantities"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Parameters:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txt_params" Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text=""/>
                        <Button x:Name="btn_params" Grid.Column="2" Content="Parameters..." Padding="10,3" Margin="5,2,0,2"
                                ToolTip="Choose the parameters holding the price codes and the Yes/No parameters that include elements in the bill"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Models:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txt_models" Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text=""/>
                        <Button x:Name="btn_scope" Grid.Column="2" Content="Models and Categories..." Padding="10,3" Margin="5,2,0,2"
                                ToolTip="Choose the linked models, the worksets to exclude and the categories to read: the models are read again"/>
                    </Grid>

                    <TextBlock x:Name="txt_settings_hint" Style="{StaticResource HintText}" Margin="0,8,0,0" Text=""/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="📁 CATEGORIES" Style="{StaticResource SectionHeader}"/>
                    <ListBox x:Name="lst_categories" Height="160"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ToolTip="Categories read from the models. Untick one to leave it out of the bill without reading the models again."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="btn_select_all" Content="Select All" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_select_none" Content="Deselect All" Padding="10,3"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="tabs" Grid.Row="2">

            <!-- TAB: EPU (elenco prezzi unitari dei codici del modello) -->
            <TabItem x:Name="tab_prices" Header="💶 EPU">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                               Text="Unit prices of the price codes used in the model and in the Manual items tab, sorted by chapter and subchapter. Source tells where a code is used; codes of manual items are in lavender italics. Chapter, Subchapter, Short Description, Description, Unit and Unit price are editable (decimal comma or point): changes go to the project file, never to the model. A cleared field falls back to the shared price list. Every code is looked up in column A of the price list (Excel: A code, B short description, C description, D unit, E unit price): red rows have a code that is not there. The funnel in a column header filters the rows by the values of that column."/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txt_search_prices" Grid.Column="1" Padding="5,3"
                                 ToolTip="Filter by chapter, subchapter, code, short description or description"/>
                        <Button x:Name="btn_clear_prices" Grid.Column="2" Content="✕" Width="25" Margin="5,0,0,0"
                                ToolTip="Clear search"/>
                        <CheckBox x:Name="chk_missing_only" Grid.Column="3" Margin="15,0,0,0" VerticalAlignment="Center"
                                  Content="Only codes not in the price list"/>
                        <Button x:Name="btn_clear_filters_prices" Grid.Column="4" Content="Clear Filters" Padding="10,3" Margin="15,0,0,0"
                                IsEnabled="False" ToolTip="Remove the filters set on the columns"/>
                    </Grid>
                    <DataGrid x:Name="dg_prices" Grid.Row="2" Style="{StaticResource GridStyle}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Codice assente dalla colonna A del listino: rosso come
                                         la formattazione "riempimento rosso chiaro" di Excel. -->
                                    <!-- Voce non modellata (scheda Manual items): lavanda e corsivo -->
                                    <DataTrigger Binding="{Binding Manual}" Value="True">
                                        <Setter Property="Background" Value="#EDE7F6"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotInPriceList}" Value="True">
                                        <Setter Property="Background" Value="#FFC7CE"/>
                                        <Setter Property="Foreground" Value="#9C0006"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Chapter" Binding="{Binding Chapter}" Width="110"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Subchapter" Binding="{Binding Subchapter}" Width="110"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Price book code" Binding="{Binding Code}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Short Description" Binding="{Binding ShortDescription}" Width="180"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="250"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridComboBoxColumn x:Name="col_unit" Header="Unit" SelectedItemBinding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice}" Width="110"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB: Bill of quantities -->
            <TabItem x:Name="tab_bill" Header="📋 Bill of quantities">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                               Text="Filled automatically from the model, the price list and the Rules tab. One row per Type Mark and code (per WBS combination when WBS levels are set, with one column per level after Amount), sorted by code, Type Mark and WBS levels. Layout...: grouping levels of the rows (Chapter, Subchapter, Type Mark, Unit, WBS levels) and WBS levels shown as columns, in the order they are added; every group has a bold row with the total of its items. With WBS levels on the columns, every combination of their values is a column after the WBS columns, with the amount of every item and group row. Click the triangle or double click a group row to collapse or expand it. Drag a column border to widen it: the table scrolls sideways and the first columns (Type Mark, price book code) stay in place. The funnel in a column header filters the items; a group stays visible while it has visible items and keeps the total of all its items. Right click (or Allowance Override...) to give the selected items an allowance of their own. Rows in lavender italics are manual items, entered by hand and not taken from the model. Export Excel keeps its own layout."/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txt_search_bill" Grid.Column="1" Padding="5,3"
                                 ToolTip="Filter by Type Mark, price book code, description or WBS value"/>
                        <Button x:Name="btn_clear_bill" Grid.Column="2" Content="✕" Width="25" Margin="5,0,0,0"
                                ToolTip="Clear search"/>
                        <Button x:Name="btn_clear_filters_bill" Grid.Column="3" Content="Clear Filters" Padding="10,3" Margin="15,0,0,0"
                                IsEnabled="False" ToolTip="Remove the filters set on the columns"/>
                        <Button x:Name="btn_allowance" Grid.Column="4" Content="Allowance Override..." Padding="10,3" Margin="15,0,0,0"
                                ToolTip="Set or remove the allowance of the selected items (also with a right click on the grid). Quantities with an override are highlighted."/>
                    </Grid>
                    <!-- Disposizione: livelli sulle righe e livelli WBS sulle colonne (Layout...) -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Layout:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txt_layout" Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text=""/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btn_layout" Content="Layout..." Padding="10,3" Margin="5,2,0,2"
                                    ToolTip="Choose the grouping levels of the rows and the WBS levels shown as columns"/>
                            <Button x:Name="btn_expand_all" Content="Expand All" Padding="10,3" Margin="15,2,0,2"/>
                            <Button x:Name="btn_collapse_all" Content="Collapse All" Padding="10,3" Margin="5,2,0,2"/>
                        </StackPanel>
                    </Grid>
                    <!-- Colonne a larghezza fissa e scorrimento orizzontale: allargando una colonna la
                         tabella scorre invece di stringere le altre. Le prime tre (triangolino,
                         Type Mark, Price book code) restano ferme. -->
                    <DataGrid x:Name="dg_bill" Grid.Row="3" Style="{StaticResource GridStyle}" IsReadOnly="True"
                              HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True"
                              FrozenColumnCount="3">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Righe di gruppo: grassetto, fondo piu' scuro ai livelli alti -->
                                    <DataTrigger Binding="{Binding Kind}" Value="group">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="#F0F4F8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Shade}" Value="g0">
                                        <Setter Property="Background" Value="#C9D6E3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Shade}" Value="g1">
                                        <Setter Property="Background" Value="#DFE7EF"/>
                                    </DataTrigger>
                                    <!-- Voce non modellata (scheda Manual items): lavanda e corsivo -->
                                    <DataTrigger Binding="{Binding Manual}" Value="True">
                                        <Setter Property="Background" Value="#EDE7F6"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type Mark" Binding="{Binding TypeMark}" Width="90"/>
                            <DataGridTextColumn Header="Price book code" Binding="{Binding Code}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="380" MinWidth="120"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:0.##}}" Width="85"
                                                ElementStyle="{StaticResource NumberCell}">
                                <!-- Voce con override della maggiorazione: cella colorata e
                                     tooltip con il valore; la selezione resta visibile. -->
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllowanceOverride}" Value="True">
                                                <Setter Property="Background" Value="#FFE3A3"/>
                                                <Setter Property="ToolTip" Value="{Binding AllowanceTip}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="115"
                                                ElementStyle="{StaticResource NumberCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB: CME (computo metrico estimativo): la vista per combinazioni WBS,
                 come il foglio Bill of quantities dell'export Excel -->
            <TabItem x:Name="tab_cme" Header="🧾 CME">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                               Text="Computo metrico estimativo, laid out as the Bill of quantities sheet of Export Excel. Rows in lavender italics are manual items, entered by hand and not taken from the model. Drag a column border to widen it: the table scrolls sideways and the WBS columns, Type Mark and price book code stay in place. Filled automatically from the model, the price list and the Rules tab. Pieces are counted; ducts, pipes, flex, cable trays, conduits and insulation are measured in the unit of the code, allowance for fittings included. One row per Type Mark and code. Elements without Type Mark are excluded. Right click (or Allowance Override...) to give the selected items an allowance of their own: their quantity is highlighted. With WBS levels set (WBS Levels... button), the first columns are the WBS levels and every combination has one bold row with its total, followed by its items. The funnel in a column header filters the items by the values of that column: a combination row stays visible while it has visible items and keeps the total of all its items. Filters only change what is shown: the total below and Export Excel include every item."/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txt_search_cme" Grid.Column="1" Padding="5,3"
                                 ToolTip="Filter by Type Mark, price book code, description or WBS value"/>
                        <Button x:Name="btn_clear_cme" Grid.Column="2" Content="✕" Width="25" Margin="5,0,0,0"
                                ToolTip="Clear search"/>
                        <Button x:Name="btn_clear_filters_cme" Grid.Column="3" Content="Clear Filters" Padding="10,3" Margin="15,0,0,0"
                                IsEnabled="False" ToolTip="Remove the filters set on the columns"/>
                        <Button x:Name="btn_allowance_cme" Grid.Column="4" Content="Allowance Override..." Padding="10,3" Margin="15,0,0,0"
                                ToolTip="Set or remove the allowance of the selected items (also with a right click on the grid). Quantities with an override are highlighted."/>
                    </Grid>
                    <!-- Colonne a larghezza fissa e scorrimento orizzontale, come il Bill of
                         quantities. Le colonne ferme (WBS, Type Mark, Price book code)
                         si impostano nel codice, perche' le colonne WBS si creano li'. -->
                    <DataGrid x:Name="dg_cme" Grid.Row="2" Style="{StaticResource GridStyle}" IsReadOnly="True"
                              HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="group">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="#EEF3F8"/>
                                    </DataTrigger>
                                    <!-- Voce non modellata (scheda Manual items): lavanda e corsivo -->
                                    <DataTrigger Binding="{Binding Manual}" Value="True">
                                        <Setter Property="Background" Value="#EDE7F6"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type Mark" Binding="{Binding TypeMark}" Width="90"/>
                            <DataGridTextColumn Header="Price book code" Binding="{Binding Code}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="380" MinWidth="120"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:0.##}}" Width="85"
                                                ElementStyle="{StaticResource NumberCell}">
                                <!-- Voce con override della maggiorazione: cella colorata e
                                     tooltip con il valore; la selezione resta visibile. -->
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllowanceOverride}" Value="True">
                                                <Setter Property="Background" Value="#FFE3A3"/>
                                                <Setter Property="ToolTip" Value="{Binding AllowanceTip}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="115"
                                                ElementStyle="{StaticResource NumberCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB: Manual items (voci non modellate, scritte a mano) -->
            <TabItem x:Name="tab_manual" Header="✍️ Manual items">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                               Text="Items that are not in the model, written by hand: WBS values, Type Mark, price book code, description, unit, quantity and unit price (decimal comma or point). Description, unit and unit price belong to the code, as in the EPU tab: changing them here changes them there, and a code of the price list brings its own values. Rows with a code and a quantity are added to the EPU, Bill of quantities and CME tabs, in lavender italics; orange rows are not counted yet. Save writes them to the project file."/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                        <Button x:Name="btn_manual_add" Content="Add Row" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_manual_duplicate" Content="Duplicate" Padding="10,3" Margin="0,0,5,0"
                                ToolTip="Copy the selected rows"/>
                        <Button x:Name="btn_manual_remove" Content="Remove Selected" Padding="10,3"/>
                        <TextBlock x:Name="txt_manual_count" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                   Margin="15,0,0,0" Text=""/>
                    </StackPanel>
                    <DataGrid x:Name="dg_manual" Grid.Row="2" Style="{StaticResource GridStyle}"
                              HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True" CanUserSortColumns="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Senza codice o quantita': non entra nel computo -->
                                    <DataTrigger Binding="{Binding Incomplete}" Value="True">
                                        <Setter Property="Background" Value="#FFF0D9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type Mark" Binding="{Binding TypeMark}" Width="90"/>
                            <DataGridTextColumn Header="Price book code" Binding="{Binding Code}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="380" MinWidth="120"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridComboBoxColumn Header="Unit" SelectedItemBinding="{Binding Unit}" Width="70"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="85"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice}" Width="100"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="115"
                                                ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB: Type Marks -->
            <TabItem x:Name="tab_marks" Header="🏷️ Type Marks">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                               Text="One bold row per category, Type Mark, family type, nesting, model and set of codes, followed by one row per price code with its description. Parameter: the parameter that holds the code, set with Parameters..., followed by (T) for a type parameter or (I) for an instance parameter (a type parameter missing on the type is read on the instance and shows (I)). Both are counted. Types whose instances carry different instance codes (e.g. ducts and pipes by size) appear once per set of codes. Searching a Type Mark shows all its codes; searching a code also shows the row of its type."/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txt_search_marks" Grid.Column="1" Padding="5,3"
                                 ToolTip="Filter by category, Type Mark, family, type or code"/>
                        <Button x:Name="btn_clear_marks" Grid.Column="2" Content="✕" Width="25" Margin="5,0,0,0"
                                ToolTip="Clear search"/>
                    </Grid>
                    <DataGrid x:Name="dg_marks" Grid.Row="2" Style="{StaticResource GridStyle}" IsReadOnly="True"
                              CanUserSortColumns="False">
                        <!-- Riga di gruppo per tipo, poi una riga per codice: l'ordine delle
                             righe e' la struttura, quindi niente riordino per colonna. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="group">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="#EEF3F8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Type Mark" Binding="{Binding TypeMark}" Width="110"/>
                            <DataGridTextColumn Header="Family and Type" Binding="{Binding Types}" Width="220"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Nested" Binding="{Binding Nested}" Width="60"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="140"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Slot}" Width="190"/>
                            <DataGridTextColumn Header="Price book code" Binding="{Binding Code}" Width="160"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="250"
                                                ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB: Rules -->
            <TabItem x:Name="tab_rules" Header="📐 Rules">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                               Text="Measurement rules of the linear categories, from the company QTO sheets. Ducts and pipes are measured in the unit of their price code (m, mq or kg), cable trays and conduits always in m, insulation in mq or m. Every linear quantity is increased by the allowance of its category for fittings and waste. Changes are stored in the project file."/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="➕ FITTINGS AND WASTE" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                                           Text="Percentage added to length, area and weight, because fittings are not measured (30% in the QTO sheets)."/>
                                <DataGrid x:Name="dg_allowance" Grid.Row="2" Style="{StaticResource GridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Allowance %" Binding="{Binding Allowance}" Width="90"
                                                            ElementStyle="{StaticResource NumberCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="⚖️ DUCT SHEET WEIGHT" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                                           Text="kg = kg/mq x duct surface. A band applies when the largest side (the diameter for round ducts) is below its limit; an empty limit is the last band."/>
                                <DataGrid x:Name="dg_duct_weight" Grid.Row="2" Style="{StaticResource GridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Shape" Binding="{Binding ShapeLabel}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Side below [mm]" Binding="{Binding Limit}" Width="105"
                                                            ElementStyle="{StaticResource NumberCell}"/>
                                        <DataGridTextColumn Header="kg/mq" Binding="{Binding Weight}" Width="70"
                                                            ElementStyle="{StaticResource NumberCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🔩 PIPE STEEL DENSITY" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                                           Text="kg = density x pi/4 x (OD&#178; - ID&#178;) x length. Only pipes whose Type Mark is listed can be measured in kg."/>
                                <DataGrid x:Name="dg_density" Grid.Row="2" Style="{StaticResource GridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type Mark" Binding="{Binding TypeMark}" Width="80"/>
                                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                        <DataGridTextColumn Header="kg/mc" Binding="{Binding Density}" Width="70"
                                                            ElementStyle="{StaticResource NumberCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <Button x:Name="btn_density_add" Content="Add row" Padding="10,3" Margin="0,0,5,0"/>
                                    <Button x:Name="btn_density_remove" Content="Remove selected" Padding="10,3"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="btn_rules_defaults" Content="Restore defaults" Padding="10,3"
                                ToolTip="Put back the values of the company QTO sheets"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB: Issues -->
            <TabItem x:Name="tab_issues" Header="⚠️ Issues">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                               Text="The Element Ids of every issue are listed in the Issues sheet of the Excel export."/>
                    <DataGrid x:Name="dg_issues" Grid.Row="1" Style="{StaticResource GridStyle}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Issue" Binding="{Binding Kind}" Width="190"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="200"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Instances" Binding="{Binding Instances}" Width="75"
                                                ElementStyle="{StaticResource NumberCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txt_status" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0" Text=""/>
            <TextBlock x:Name="txt_total" Grid.Column="1" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Text=""/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btn_close" Content="Close" Width="100" Height="30" Margin="0,0,10,0"/>
            <Button x:Name="btn_export" Content="Export Excel..." Width="120" Height="30" Margin="0,0,10,0"/>
            <Button x:Name="btn_save" Content="Save" Width="100" Height="30"
                    Background="#2D5A8A" Foreground="White"
                    ToolTip="Save descriptions, units and unit prices to the project file"/>
        </StackPanel>
    </Grid>
</Window>
