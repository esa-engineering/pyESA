<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Price list editor"
        Height="760" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="📒 Price list editor"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- SECTION: File -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📁 PRICE LIST FILE" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="File:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txt_path" Grid.Row="0" Grid.Column="1" Padding="5,3" Margin="0,2"
                             IsReadOnly="True" Background="#F8F8F8"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btn_new" Content="New" Padding="10,3" Margin="5,2,0,2"/>
                        <Button x:Name="btn_open" Content="Open..." Padding="10,3" Margin="5,2,0,2"/>
                        <Button x:Name="btn_save_as" Content="Save As..." Padding="10,3" Margin="5,2,0,2"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Name:" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txt_name" Grid.Column="0" Padding="5,3" Margin="0,2"
                                 ToolTip="Name of the price list, e.g. ESA price list 2026"/>
                        <TextBlock Grid.Column="1" Text="Currency:" Style="{StaticResource FieldLabel}" Margin="15,0,10,0"/>
                        <TextBox x:Name="txt_currency" Grid.Column="2" Style="{StaticResource InputField}"/>
                    </Grid>
                </Grid>
                <TextBlock x:Name="txt_file_hint" Style="{StaticResource HintText}" Margin="0,5,0,0" Text=""/>
            </StackPanel>
        </Border>

        <!-- SECTION: Items -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="💶 ITEMS" Style="{StaticResource SectionHeader}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                           Text="Every column is editable; the price book code must be unique. Unit price accepts a decimal comma or point. Import reads .xlsx, .xlsm, .csv or another .json price list."/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txt_search" Grid.Column="1" Padding="5,3"
                             ToolTip="Filter by chapter, subchapter, EPU item No., price book, code, short description or description"/>
                    <Button x:Name="btn_clear_search" Grid.Column="2" Content="✕" Width="25" Margin="5,0,0,0"
                            ToolTip="Clear search"/>
                    <Button x:Name="btn_import" Grid.Column="3" Content="Import Excel / CSV..." Padding="10,3" Margin="15,0,0,0"/>
                </Grid>
                <DataGrid x:Name="dg_items" Grid.Row="3" Margin="0,5,0,0"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" SelectionUnit="FullRow" SelectionMode="Extended"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8E8E8" AlternatingRowBackground="#FAFAFA"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Chapter" Binding="{Binding Chapter}" Width="120"
                                            ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn Header="Subchapter" Binding="{Binding Subchapter}" Width="120"
                                            ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn Header="EPU item No." Binding="{Binding EpuItem}" Width="90"/>
                        <DataGridTextColumn Header="Reference price book" Binding="{Binding PriceBook}" Width="130"
                                            ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn Header="Price book code" Binding="{Binding Code}" Width="120"/>
                        <DataGridTextColumn Header="Short Description" Binding="{Binding ShortDescription}" Width="180"
                                            ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="250"
                                            ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridComboBoxColumn x:Name="col_unit" Header="Unit" SelectedItemBinding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice}" Width="100"
                                            ElementStyle="{StaticResource NumberCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="4" Margin="0,5,0,0">
                    <TextBlock x:Name="txt_count" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0" Text=""/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btn_add" Content="Add Row" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_duplicate" Content="Duplicate" Padding="10,3" Margin="0,0,5,0"/>
                        <Button x:Name="btn_remove" Content="Remove Selected" Padding="10,3"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="txt_status" Grid.Row="3" Style="{StaticResource HintText}" Margin="0,8,0,0" Text=""/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_close" Content="Close" Width="100" Height="30" Margin="0,0,10,0"/>
            <Button x:Name="btn_save" Content="Save" Width="100" Height="30"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
