<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crea Abachi - Nomi gia' esistenti"
        Height="500" Width="760"
        MinHeight="360" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        Background="#FFF4F5F7">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#FF2D3E50"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#FF7A8794"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FFD8DDE3"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FFB3541E"/>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <Style x:Key="MainBtn" TargetType="Button">
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <DataTemplate x:Key="ConflictTemplate">
            <Grid Margin="2,4,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding subtitle}" FontSize="10"
                               Foreground="{StaticResource SubtleBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="150" Height="24" Margin="10,0,4,0"
                          VerticalAlignment="Center"
                          SelectedIndex="{Binding action_index, Mode=TwoWay}"
                          SelectionChanged="on_action_changed">
                    <ComboBoxItem Content="Rinomina"/>
                    <ComboBoxItem Content="Sovrascrivi"/>
                    <ComboBoxItem Content="Salta"/>
                </ComboBox>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Alcuni nomi esistono gia' nel progetto"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Scegli come procedere per ciascun nome in conflitto. Rinomina: aggiunge un suffisso incrementale, es. Nome (1). Sovrascrivi: elimina la vista esistente e la ricrea (se e' posizionata su una tavola, verra' rimossa dalla tavola). Salta: non crea l'abaco."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Applica a tutti:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource MiniBtn}" Content="Rinomina"
                        Click="on_all_rename"/>
                <Button Style="{StaticResource MiniBtn}" Content="Sovrascrivi"
                        Click="on_all_overwrite"/>
                <Button Style="{StaticResource MiniBtn}" Content="Salta"
                        Click="on_all_skip"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ListBox x:Name="conflict_lb"
                     ItemTemplate="{StaticResource ConflictTemplate}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="warn_tb" VerticalAlignment="Center"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource WarnBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource MainBtn}" Content="Annulla tutto"
                        Click="on_cancel" IsCancel="True"/>
                <Button Style="{StaticResource MainBtn}" Content="Procedi"
                        Click="on_ok" IsDefault="True" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
