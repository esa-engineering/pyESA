<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiungi parametri alle schedule"
        Height="660" Width="980"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Background="#FFF4F5F7">

    <Window.Resources>

        <!-- palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF1F6FEB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FF1B1F24"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#FFD8DCE3"/>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF0B4FBF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource MainButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- riga con checkbox: nome + info -->
        <DataTemplate x:Key="CheckItemTemplate">
            <!-- IsChecked non e' in binding: viene impostato da item_loaded, cosi'
                 lo stato non dipende da INotifyPropertyChanged. -->
            <CheckBox Loaded="item_loaded"
                      Checked="item_checked"
                      Unchecked="item_unchecked"
                      Margin="2,3,2,3"
                      VerticalContentAlignment="Center">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="{Binding name}" FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding info}" Style="{StaticResource SubtleTextStyle}"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <Style x:Key="CheckListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="Background" Value="#FFFCFCFD"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CheckItemTemplate}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <!-- Virtualizzazione attiva (l'elenco dei nativi puo' contare migliaia di
                 voci) in modalita' Standard: i container non vengono riciclati, quindi
                 item_loaded rientra a ogni realizzazione e ripristina lo stato. -->
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Standard"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="root" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="#FFEEF3FC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- intestazione -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Aggiungi parametri alle schedule"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap"
                       Text="Seleziona le schedule da modificare e i parametri da aggiungere come campi. I parametri non disponibili per la categoria della singola schedule vengono saltati e riportati nel report finale."/>
        </StackPanel>

        <!-- due pannelli -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- schedule -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="1. Schedule" Style="{StaticResource PanelTitleStyle}"/>

                    <TextBox Grid.Row="1" x:Name="schedules_filter" Height="26"
                             VerticalContentAlignment="Center" Padding="6,0,6,0"
                             TextChanged="schedules_filter_changed"
                             ToolTip="Filtra per nome o categoria"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
                        <Button Content="Seleziona tutte" Style="{StaticResource LinkButtonStyle}"
                                Click="schedules_check_all"/>
                        <TextBlock Text="|" Foreground="{StaticResource BorderBrush2}" Margin="4,0"/>
                        <Button Content="Deseleziona tutte" Style="{StaticResource LinkButtonStyle}"
                                Click="schedules_uncheck_all"/>
                    </StackPanel>

                    <ListBox Grid.Row="3" x:Name="schedules_list" Style="{StaticResource CheckListStyle}"/>

                    <TextBlock Grid.Row="4" x:Name="schedules_count" Margin="0,6,0,0"
                               Style="{StaticResource SubtleTextStyle}"/>
                </Grid>
            </Border>

            <!-- parametri -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="2. Parametri"
                               Style="{StaticResource PanelTitleStyle}"/>

                    <!-- sorgente dei parametri + filtro di disponibilita' -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="src_all" GroupName="ParamSource"
                                         Content="Tutti" IsChecked="True" FontSize="11"
                                         VerticalContentAlignment="Center" Margin="0,0,10,0"
                                         Checked="params_source_changed"/>
                            <RadioButton x:Name="src_project" GroupName="ParamSource"
                                         Content="Progetto e condivisi" FontSize="11"
                                         VerticalContentAlignment="Center" Margin="0,0,10,0"
                                         Checked="params_source_changed"/>
                            <RadioButton x:Name="src_native" GroupName="ParamSource"
                                         Content="Nativi Revit" FontSize="11"
                                         VerticalContentAlignment="Center"
                                         Checked="params_source_changed"/>
                        </StackPanel>
                        <CheckBox x:Name="only_common" Margin="0,6,0,0" FontSize="11"
                                  Content="Solo parametri disponibili in tutte le schedule selezionate"
                                  VerticalContentAlignment="Center"
                                  Checked="params_source_changed"
                                  Unchecked="params_source_changed"/>
                    </StackPanel>

                    <TextBox Grid.Row="2" x:Name="params_filter" Height="26"
                             VerticalContentAlignment="Center" Padding="6,0,6,0"
                             TextChanged="params_filter_changed"
                             ToolTip="Filtra per nome, tipo o sorgente"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,6">
                        <Button Content="Seleziona i mostrati" Style="{StaticResource LinkButtonStyle}"
                                Click="params_check_all"/>
                        <TextBlock Text="|" Foreground="{StaticResource BorderBrush2}" Margin="4,0"/>
                        <Button Content="Deseleziona tutti" Style="{StaticResource LinkButtonStyle}"
                                Click="params_uncheck_all"/>
                    </StackPanel>

                    <ListBox Grid.Row="4" x:Name="params_list" Style="{StaticResource CheckListStyle}"/>

                    <TextBlock Grid.Row="5" x:Name="params_count" Margin="0,6,0,0"
                               Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- opzioni -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,12,0,0" Padding="10,8">
            <CheckBox x:Name="hidden_fields" Content="Aggiungi i campi come nascosti (utili per filtri e ordinamenti)"
                      FontSize="12" VerticalContentAlignment="Center"/>
        </Border>

        <!-- pulsanti -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annulla" Style="{StaticResource MainButtonStyle}" Click="cancel_click"/>
            <Button Content="Aggiungi parametri" Style="{StaticResource AccentButtonStyle}"
                    Click="run_click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
