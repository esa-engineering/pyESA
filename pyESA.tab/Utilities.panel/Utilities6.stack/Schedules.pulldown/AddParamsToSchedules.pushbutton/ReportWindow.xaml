<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report - Aggiunta parametri alle schedule"
        Height="620" Width="1040"
        MinHeight="420" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Background="#FFF4F5F7">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#FF1F6FEB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FF1B1F24"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#FFD8DCE3"/>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
        </Style>

        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource MainButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- colore riga in base all'esito -->
        <Style x:Key="ResultRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding outcome}" Value="Aggiunto">
                    <Setter Property="Background" Value="#FFEFF9F1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding outcome}" Value="Già presente">
                    <Setter Property="Background" Value="#FFF7F8FA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding outcome}" Value="Non disponibile">
                    <Setter Property="Background" Value="#FFFFF7E6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding outcome}" Value="Errore">
                    <Setter Property="Background" Value="#FFFDECEC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,4,6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- intestazione -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Report operazione" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="summary_text" Margin="0,4,0,0" FontSize="12"
                       Foreground="{StaticResource SubtleTextBrush}"/>
        </StackPanel>

        <!-- filtro -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="only_issues" Content="Mostra solo scarti ed errori"
                      FontSize="12" VerticalContentAlignment="Center"
                      Checked="filter_changed" Unchecked="filter_changed"/>
        </StackPanel>

        <!-- tabella -->
        <DataGrid Grid.Row="2" x:Name="results_grid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush2}"
                  BorderBrush="{StaticResource BorderBrush2}"
                  BorderThickness="1"
                  RowStyle="{StaticResource ResultRowStyle}"
                  RowHeaderWidth="0"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Schedule" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding schedule}" Style="{StaticResource CellTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Parametro" Width="1.6*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding parameter}" Style="{StaticResource CellTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Esito" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding outcome}" FontWeight="SemiBold"
                                       Style="{StaticResource CellTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Dettaglio" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding detail}" Style="{StaticResource CellTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- pulsanti -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copia negli appunti" Style="{StaticResource MainButtonStyle}" Click="copy_click"/>
            <Button Content="Esporta CSV" Style="{StaticResource MainButtonStyle}" Click="export_click"/>
            <Button Content="Chiudi" Style="{StaticResource AccentButtonStyle}" Click="close_click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
