<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Workset Create"
    Height="660" Width="820"
    MinHeight="560" MinWidth="700"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header area -->
        <Border Grid.Row="0"
                BorderBrush="#CCCCCC" BorderThickness="1"
                CornerRadius="5" Padding="10">
            <StackPanel>
                <TextBlock Text="WORKSET CREATE"
                           FontWeight="Bold" FontSize="12"
                           Foreground="#2D5A8A"/>
                <TextBlock x:Name="lbl_model_name"
                           Text="Model: -"
                           FontSize="11" Foreground="Gray"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="lbl_existing"
                           Text="Existing user worksets: 0"
                           FontSize="11" Foreground="Gray"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Input source -->
        <TabControl Grid.Row="1"
                    x:Name="tab_source"
                    Margin="0,10,0,0"
                    FontSize="11">

            <!-- ===== EXCEL ===== -->
            <TabItem Header="Excel (.xlsx)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="File:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="txt_excel_path"
                             Height="24" IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Background="#F5F5F5"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            x:Name="btn_browse_excel"
                            Content="Browse..."
                            Width="90" Height="24"
                            Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Sheet:"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              x:Name="cmb_sheet"
                              Height="24" Margin="0,8,0,0"
                              VerticalContentAlignment="Center"/>

                    <CheckBox Grid.Row="2" Grid.Column="1"
                              x:Name="chk_skip_header"
                              Content="First row is a header (skip it)"
                              Margin="0,10,0,0"/>

                    <StackPanel Grid.Row="3" Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">
                        <Button x:Name="btn_load_excel"
                                Content="Load list"
                                Width="110" Height="26"/>
                        <TextBlock Text="Workset names are read from the first column (A)."
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== TXT ===== -->
            <TabItem Header="Text file (.txt)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="File:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="txt_txt_path"
                             Height="24" IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Background="#F5F5F5"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            x:Name="btn_browse_txt"
                            Content="Browse..."
                            Width="90" Height="24"
                            Margin="8,0,0,0"/>

                    <StackPanel Grid.Row="1" Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0">
                        <Button x:Name="btn_load_txt"
                                Content="Load list"
                                Width="110" Height="26"/>
                        <TextBlock Text="Names separated by comma or semicolon; line breaks also accepted."
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== MANUAL ===== -->
            <TabItem Header="Manual input">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="One workset name per row (press Enter to add a new row):"
                                   Foreground="Gray"/>
                        <!-- Header row -->
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Workset name"
                                       FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- Dynamic rows container -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="150"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,5">
                        <StackPanel x:Name="pnl_manual_rows"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0">
                        <Button x:Name="btn_manual_add"
                                Content="＋ Add workset"
                                Height="26" Padding="10,3"
                                FontSize="11"
                                Margin="0,0,10,0"/>
                        <Button x:Name="btn_manual_clear_rows"
                                Content="Clear rows"
                                Height="26" Padding="10,3"
                                FontSize="11"
                                Margin="0,0,10,0"
                                ToolTip="Remove every row and start over"/>
                        <Button x:Name="btn_load_manual"
                                Content="Load list"
                                Width="110" Height="26"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Preview list -->
        <ListView Grid.Row="2"
                  x:Name="lst_preview"
                  Margin="0,10,0,0"
                  FontSize="11"
                  SelectionMode="Extended">
            <ListView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D5A8A"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D5A8A"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding [State]}" Value="EXISTING">
                            <Setter Property="Foreground" Value="#B26A00"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding [State]}" Value="DUPLICATE">
                            <Setter Property="Foreground" Value="#B26A00"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding [State]}" Value="INVALID">
                            <Setter Property="Foreground" Value="#D32F2F"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding [State]}" Value="NEW">
                            <Setter Property="Foreground" Value="#1B7A3D"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#"
                                    Width="45"
                                    DisplayMemberBinding="{Binding [Index]}"/>
                    <GridViewColumn Header="Workset name"
                                    Width="430"
                                    DisplayMemberBinding="{Binding [Name]}"/>
                    <GridViewColumn Header="Status"
                                    Width="270"
                                    DisplayMemberBinding="{Binding [Status]}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Summary -->
        <TextBlock Grid.Row="3"
                   x:Name="lbl_summary"
                   Text="No list loaded."
                   FontSize="11" FontWeight="Bold"
                   Foreground="#2D5A8A"
                   Margin="0,8,0,0"/>

        <!-- Footer -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btn_clear"
                    Content="Clear list"
                    Width="100" Height="30"
                    Margin="0,0,10,0"/>
            <Button x:Name="btn_create"
                    Content="Create Worksets"
                    Background="#2D5A8A" Foreground="White"
                    FontWeight="Bold"
                    Width="160" Height="30"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    ToolTip="Create all worksets flagged as NEW"/>
            <Button x:Name="btn_close"
                    Content="Close"
                    Width="100" Height="30"
                    Padding="10,3" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
