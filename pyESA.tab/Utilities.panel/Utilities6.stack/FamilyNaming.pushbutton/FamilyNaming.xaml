<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family and Type Naming"
        Height="780" Width="660"
        MinHeight="560" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="DetectedValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PreviewText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🏷️ Family and Type Naming"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Scrollable body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel Margin="0,0,10,0">

                <!-- DETECTED -->
                <Border BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📌 DETECTED" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Element"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="lbl_element" Grid.Column="1" Text="-"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource DetectedValue}"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Revit category"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="lbl_revit_category" Grid.Column="1" Text="-"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource DetectedValue}"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Category code"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="lbl_category" Grid.Column="1" Text="-"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource DetectedValue}"/>
                        </Grid>

                        <Grid x:Name="grd_inplace" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Modelled in place"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="lbl_inplace" Grid.Column="1"
                                       Text="yes — the (I) marker is added"
                                       TextWrapping="Wrap" Foreground="#B06000"
                                       Style="{StaticResource DetectedValue}"/>
                        </Grid>

                        <TextBlock x:Name="lbl_detect_warning" Style="{StaticResource HintText}"
                                   Margin="150,6,0,0" Foreground="#B06000"/>
                    </StackPanel>
                </Border>

                <!-- CLASSIFICATION -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🗂️ CLASSIFICATION" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lbl_group1" Grid.Column="0" Text="Group 1"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmb_group1" Grid.Column="1"
                                      Style="{StaticResource ComboStyle}"/>
                        </Grid>
                        <TextBlock x:Name="lbl_group1_desc" Style="{StaticResource HintText}"
                                   Margin="150,0,0,4"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lbl_group2" Grid.Column="0" Text="Group 2"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmb_group2" Grid.Column="1"
                                      Style="{StaticResource ComboStyle}"/>
                        </Grid>
                        <TextBlock x:Name="lbl_group2_desc" Style="{StaticResource HintText}"
                                   Margin="150,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TYPE MARK -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔖 TYPE MARK" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Type Mark"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_typemark" Grid.Column="1" Width="110"
                                     HorizontalAlignment="Left" Padding="3,2"
                                     FontFamily="Consolas"/>
                            <TextBlock x:Name="lbl_tm_hint" Grid.Column="2"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="The next free sequential is proposed. Type over it to set the Type Mark by hand."
                                   Style="{StaticResource HintText}" Margin="150,2,0,0"/>

                        <CheckBox x:Name="chk_tm_write" Content="Write the Type Mark into the type parameter"
                                  Margin="150,8,0,0" IsChecked="True"/>
                        <TextBlock x:Name="lbl_tm_existing" Style="{StaticResource HintText}"
                                   Margin="170,2,0,0" Foreground="#B06000"/>
                    </StackPanel>
                </Border>

                <!-- CATEGORY SPECIFIC -->
                <Border x:Name="brd_specific" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚙️ CATEGORY CODING" Style="{StaticResource SectionHeader}"/>
                        <StackPanel x:Name="pnl_specific"/>
                    </StackPanel>
                </Border>

                <!-- DIMENSIONS -->
                <Border x:Name="brd_dimensions" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📐 DIMENSIONAL BLOCK" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="lbl_dim_hint" Style="{StaticResource HintText}"
                                   Margin="0,0,0,6"/>
                        <StackPanel x:Name="pnl_dimensions"/>
                    </StackPanel>
                </Border>

                <!-- DESCRIPTION -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📝 DESCRIPTION" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Optional. Only if it adds something the codes do not already say. Max 40 characters."
                                   Style="{StaticResource HintText}" Margin="0,0,0,6"/>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lbl_desc_family" Grid.Column="0"
                                       Text="Family description" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_desc_family" Grid.Column="1" Padding="3,2"/>
                        </Grid>

                        <Grid x:Name="grd_desc_type" Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lbl_desc_type" Grid.Column="0"
                                       Text="Type description"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_desc_type" Grid.Column="1" Padding="3,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- NOTES -->
                <Border x:Name="brd_notes"
                        BorderBrush="#E8E8E8" Background="#F8F8F8" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="lbl_notes_header" Text="📖 CATEGORY NOTES"
                                   Style="{StaticResource SectionHeader}"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="pnl_notes"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- PREVIEW -->
        <Border Grid.Row="2" BorderBrush="#2D5A8A" BorderThickness="1.5" CornerRadius="5"
                Padding="10" Margin="0,8,0,10">
            <StackPanel>
                <TextBlock Text="👁️ PREVIEW" Style="{StaticResource SectionHeader}"/>
                <Grid x:Name="grd_preview_family" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Family" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txt_preview_family" Grid.Column="1"
                             Style="{StaticResource PreviewText}"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txt_preview_type" Grid.Column="1"
                             Style="{StaticResource PreviewText}"/>
                </Grid>
                <TextBlock x:Name="lbl_validation" Style="{StaticResource HintText}"
                           Margin="90,6,0,0" Foreground="#C00000"/>
            </StackPanel>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btn_cancel" Content="Cancel" Width="90" Height="30"
                    Margin="0,0,8,0"/>
            <Button x:Name="btn_apply" Content="Rename" Width="100" Height="30"
                    IsDefault="True" Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
