<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turn"
        Width="440" Height="520"
        MinWidth="380" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="↪ TURN" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📐 ANGLE"/>
                        <TextBlock x:Name="SavedText" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="AnglePanel" Margin="0,0,0,6"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Custom:"/>
                            <TextBox Grid.Column="1" x:Name="CustomBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" x:Name="RangeText" Style="{StaticResource UnitLabel}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📏 LENGTH AND SLOPE"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Length:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm (new run after the elbow)"/>
                        </Grid>
                        <RadioButton x:Name="KeepSlope" GroupName="Slope" Margin="0,6,0,3"
                                     Content="Keep the slope of the original run"/>
                        <RadioButton x:Name="Horizontal" GroupName="Slope" Margin="0,3"
                                     Content="Make the new run horizontal"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🧱 CLASHES"/>
                        <CheckBox x:Name="AvoidClashCheck" Margin="0,3"
                                  Content="Run parallel to walls, beams and columns hit (also in links)"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="20,3,0,0"
                                   Text="Checks walls, curtain walls, columns and beams along the new run, also in linked RVT and IFC models. On a hit the angle is adjusted so that the new run follows the element; the report shows the adjusted angle and the clearance."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Click an angle button to start, or type a custom angle and press Use custom. Everything is saved for the next time. Then click each element near its free end, and on the side the new run must turn to; ESC to finish."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Use custom" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
