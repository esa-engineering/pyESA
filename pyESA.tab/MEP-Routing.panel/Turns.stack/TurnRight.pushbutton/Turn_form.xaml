<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turn Settings"
        Width="440" Height="500"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="↪ TURN SETTINGS" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📏 LENGTH"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Length:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm (new run after the elbow)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📐 TURN ANGLE"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Angle:"/>
                            <ComboBox Grid.Column="1" x:Name="AngleCombo" Style="{StaticResource ComboStyle}"/>
                        </Grid>
                        <Grid Margin="20,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Custom:"/>
                            <TextBox Grid.Column="1" x:Name="AngleBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="degrees (0 - 90)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📉 SLOPE"/>
                        <RadioButton x:Name="KeepSlope" GroupName="Slope" Margin="0,3"
                                     Content="Keep the slope of the original run"/>
                        <RadioButton x:Name="Horizontal" GroupName="Slope" Margin="0,3"
                                     Content="Make the new run horizontal"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource HintText}"
                               Text="These settings are shared by Turn Right and Turn Left and are kept for the next normal clicks. Right and left are relative to the direction of travel, looking from the element towards the end you click. A yellow bar reminds you when the angle is not 90 degrees or the new run is forced horizontal."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
