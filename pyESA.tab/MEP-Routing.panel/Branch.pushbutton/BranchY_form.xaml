<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y Branch"
        Width="480" Height="680"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D5A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⑂ Y BRANCH" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,10">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource HintText}"/>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🧭 SIDE OF THE BRANCH"/>
                        <Grid HorizontalAlignment="Center" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <RadioButton Grid.Row="0" Grid.Column="1" x:Name="DirUp" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="⬆ Up"/>
                            <RadioButton Grid.Row="1" Grid.Column="0" x:Name="DirLeft" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="⬅ Left"/>
                            <Border Grid.Row="1" Grid.Column="1" Width="46" Height="46" CornerRadius="23"
                                    BorderBrush="#2D5A8A" BorderThickness="3" Background="#E8E8E8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="riser" FontSize="10" Foreground="Gray"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <RadioButton Grid.Row="1" Grid.Column="2" x:Name="DirRight" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="Right ➡"/>
                            <RadioButton Grid.Row="2" Grid.Column="1" x:Name="DirDown" GroupName="Dir"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Content="⬇ Down"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="As seen on screen in the current plan view (the riser seen from above)."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="↕ ELEVATION OF THE HORIZONTAL RUN"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Level:"/>
                            <ComboBox Grid.Column="1" x:Name="LevelCombo" Style="{StaticResource ComboStyle}"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Offset:"/>
                            <TextBox Grid.Column="1" x:Name="OffsetBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm from the level to the axis of the horizontal run"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="The Y branch is placed on the riser below this elevation, where the inclined run starts. If that point falls outside a pipe, the pipe is first extended up to it (plus 300 mm for the fitting). Whatever is connected to the extended end is disconnected."/>
                        <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="5" Background="#F8F8F8"
                                Padding="8" Margin="0,8,0,0">
                            <TextBlock x:Name="PipesText" Style="{StaticResource HintText}" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="📐 BRANCH"/>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Angle:"/>
                            <ComboBox Grid.Column="1" x:Name="AngleCombo" Width="70" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="degrees between the inclined run and the riser axis"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Distance:"/>
                            <TextBox Grid.Column="1" x:Name="LengthBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, riser axis to the start of the horizontal run"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Horizontal run:"/>
                            <TextBox Grid.Column="1" x:Name="HorizontalBox" Style="{StaticResource InputField}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource UnitLabel}" Text="mm, length of the horizontal run"/>
                        </Grid>
                        <TextBlock x:Name="FamilyText" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="100" Height="30" IsDefault="True"
                    Background="#2D5A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
